
# Helpers para descobrir versões de releases no GitHub e GitLab
#
# Funções oferecidas:
# - require_jq: garante que jq está disponível (instala fallback se necessário)
# - github_latest_tag OWNER/REPO: retorna a tag mais recente do GitHub
# - gitlab_latest_tag PROJECT_ID: retorna a tag mais recente do GitLab
#
# Deve ser incluído imediatamente após {{ template "common/script_helper" . }} porque
# usa as funções info/warn/error/success definidas lá.
#
# Por que jq? (REL-04, D-10, D-11):
# - Parseia JSON de forma robusta e portável (curl | grep | sed é frágil)
# - Elimina dependência de GNU grep -P (não disponível no macOS)
# - Permite validação estruturada de campos JSON
#
# GITHUB_TOKEN (se definido) é enviado APENAS como header Authorization,
# nunca em stdout/stderr/URL, para evitar vazamento em logs (T-01-07).

# require_jq: garante que jq está disponível
# Retorna 0 se jq está no PATH ou foi instalado com sucesso.
# Retorna 1 se a instalação falhar.
require_jq() {
  # Se jq já está disponível, retorna imediatamente
  if command -v jq >/dev/null 2>&1; then
    return 0
  fi

  # Detecta plataforma
  local os arch jq_url jq_sha jq_dest
  os=$(uname -s)
  arch=$(uname -m)

  case "$os" in
    Linux)
      case "$arch" in
        x86_64|amd64)
          jq_url="https://github.com/jqlang/jq/releases/download/jq-1.8.2/jq-linux-amd64"
          jq_sha="b1c22172dd303f3be49e935aa56aa48a8b7a46e0bc838b4997d3bb451495870f"
          ;;
        aarch64|arm64)
          jq_url="https://github.com/jqlang/jq/releases/download/jq-1.8.2/jq-linux-arm64"
          jq_sha="8b85c817833814ddca00a144c33705546355afccf0cf39b188f3cdb48b852309"
          ;;
        *)
          error "Arquitetura não suportada para fallback de jq: $arch" >&2
          error "Instale jq com o gerenciador de pacotes (apt install jq / pacman -S jq)" >&2
          return 1
          ;;
      esac
      ;;
    Darwin)
      case "$arch" in
        x86_64)
          jq_url="https://github.com/jqlang/jq/releases/download/jq-1.8.2/jq-macos-amd64"
          jq_sha="e94b266e3c26690550006abe63152b782280f4e14374accdf04cbde844f00bc0"
          ;;
        arm64)
          jq_url="https://github.com/jqlang/jq/releases/download/jq-1.8.2/jq-macos-arm64"
          jq_sha="2d75340ba57a4b4b4c8708a21c2dc8e958a48aaa8bba13b27f77f6e4c0eca07e"
          ;;
        *)
          error "Arquitetura não suportada para fallback de jq: $arch" >&2
          error "Instale jq com Homebrew: brew install jq" >&2
          return 1
          ;;
      esac
      ;;
    *)
      error "Sistema operacional não suportado para fallback de jq: $os" >&2
      error "Instale jq com o gerenciador de pacotes apropriado" >&2
      return 1
      ;;
  esac

  # Termux: usa pkg install
  if [ -n "${TERMUX_VERSION:-}" ] && command -v pkg >/dev/null 2>&1; then
    info "Instalando jq via Termux pkg..."
    if pkg install -y jq; then
      return 0
    else
      error "Falha ao instalar jq via pkg" >&2
      return 1
    fi
  fi

  # Download do jq pinado
  jq_dest="$HOME/.local/bin/jq"
  mkdir -p "$HOME/.local/bin"

  info "Baixando jq 1.8.2 para $jq_dest..."
  if ! curl -fsSL "$jq_url" -o "$jq_dest"; then
    error "Falha no download de jq" >&2
    error "Instale jq manualmente com o gerenciador de pacotes" >&2
    rm -f "$jq_dest"
    return 1
  fi

  # Verifica SHA-256
  local actual_sha
  if command -v sha256sum >/dev/null 2>&1; then
    actual_sha=$(sha256sum "$jq_dest" | cut -d' ' -f1)
  elif command -v shasum >/dev/null 2>&1; then
    actual_sha=$(shasum -a 256 "$jq_dest" | cut -d' ' -f1)
  else
    error "Nenhum comando sha256sum/shasum disponível para verificar checksum" >&2
    rm -f "$jq_dest"
    return 1
  fi

  if [ "$actual_sha" != "$jq_sha" ]; then
    error "Checksum SHA-256 de jq não confere!" >&2
    error "  Esperado: $jq_sha" >&2
    error "  Obtido:   $actual_sha" >&2
    rm -f "$jq_dest"
    return 1
  fi

  chmod +x "$jq_dest"
  export PATH="$HOME/.local/bin:$PATH"

  if command -v jq >/dev/null 2>&1; then
    info "jq 1.8.2 instalado com sucesso em $jq_dest"
    return 0
  else
    error "jq instalado mas não está no PATH" >&2
    return 1
  fi
}

# github_latest_tag OWNER/REPO
# Retorna a tag mais recente (ex: v0.66.3) do repositório GitHub.
# Retorna 1 e imprime erro em stderr se falhar.
github_latest_tag() {
  local repo="$1"

  # Garante que jq está disponível
  if ! require_jq; then
    return 1
  fi

  local url="https://api.github.com/repos/${repo}/releases/latest"
  local curl_args=(-fsSL -H "Accept: application/vnd.github+json")

  # Adiciona token se GITHUB_TOKEN estiver definido
  # Token vai APENAS no header, nunca em stdout/stderr/URL (T-01-07)
  if [ -n "${GITHUB_TOKEN:-}" ]; then
    curl_args+=(-H "Authorization: Bearer $GITHUB_TOKEN")
  fi

  curl_args+=("$url")

  # Executa curl
  local json
  if ! json=$(curl "${curl_args[@]}" 2>&1); then
    error "Failed to query GitHub releases for $repo (network, HTTP error or rate limit; set GITHUB_TOKEN to raise the GitHub limit)" >&2
    return 1
  fi

  # Extrai tag_name com jq e remove \r (Windows)
  local tag
  tag=$(printf '%s' "$json" | jq -r '.tag_name // empty' 2>/dev/null | tr -d '\r')
  local jq_exit=$?

  if [ $jq_exit -ne 0 ]; then
    error "Invalid JSON from GitHub for $repo" >&2
    return 1
  fi

  # Valida formato da tag: ^v?[0-9]+(\.[0-9]+){1,3}([-+][0-9A-Za-z.-]+)?$
  if ! [[ "$tag" =~ ^v?[0-9]+(\.[0-9]+){1,3}([-+][0-9A-Za-z.-]+)?$ ]]; then
    error "Unexpected release tag '$tag' for $repo" >&2
    return 1
  fi

  # Retorna apenas a tag (sem quebra de linha adicional)
  printf '%s' "$tag"
  return 0
}

# gitlab_latest_tag PROJECT_ID
# Retorna a tag mais recente (ex: v1.132.0) do projeto GitLab.
# Retorna 1 e imprime erro em stderr se falhar.
gitlab_latest_tag() {
  local project_id="$1"

  # Garante que jq está disponível
  if ! require_jq; then
    return 1
  fi

  local url="https://gitlab.com/api/v4/projects/${project_id}/releases/permalink/latest"

  # Executa curl
  local json
  if ! json=$(curl -fsSL "$url" 2>&1); then
    error "Failed to query GitLab releases for project $project_id (network, HTTP error or rate limit)" >&2
    return 1
  fi

  # Extrai tag_name com jq e remove \r (Windows)
  local tag
  tag=$(printf '%s' "$json" | jq -r '.tag_name // empty' 2>/dev/null | tr -d '\r')
  local jq_exit=$?

  if [ $jq_exit -ne 0 ]; then
    error "Invalid JSON from GitLab for project $project_id" >&2
    return 1
  fi

  # Valida formato da tag: ^v?[0-9]+(\.[0-9]+){1,3}([-+][0-9A-Za-z.-]+)?$
  if ! [[ "$tag" =~ ^v?[0-9]+(\.[0-9]+){1,3}([-+][0-9A-Za-z.-]+)?$ ]]; then
    error "Unexpected release tag '$tag' for project $project_id" >&2
    return 1
  fi

  # Retorna apenas a tag (sem quebra de linha adicional)
  printf '%s' "$tag"
  return 0
}
