#!/usr/bin/env bash

{{ template "common/script_is_not_ephemeral" . }}
{{ template "common/script_eval_mise" . }}
{{ template "common/script_helper" . }}
{{ template "workplace/script_is_not_vps" . }}

info ">>>>>> 🤖 Installing AI Tools 🤖 <<<<<<<"

{{- $chezmoi := .chezmoi -}}

{{- /* Install NPM tools */ -}}
{{ range .ai_tools.npm }}
{{- $featureEnabled := false -}}
{{- if eq .feature_flag "harness" }}{{ $featureEnabled = $.features.ai.harness }}{{- end -}}
{{- if eq .feature_flag "harness_tools" }}{{ $featureEnabled = $.features.ai.harness_tools }}{{- end -}}
{{- if eq .feature_flag "spec_tools" }}{{ $featureEnabled = $.features.ai.spec_tools }}{{- end -}}
{{- if eq .feature_flag "multiplexer" }}{{ $featureEnabled := and (not $.settings.vps ) ($.features.ai.multiplexer) }}{{- end -}}
{{- $blocked := false -}}
{{- if and (hasKey . "block_on_workplace") (eq .block_on_workplace $.settings.workplace) }}{{ $blocked = true }}{{- end -}}

{{ if and $featureEnabled (not $blocked) }}
info ">>>> Installing {{ .name }} (NPM) <<<"
{{ if hasKey . "env" }}{{ .env }} {{ end }}npm install -g {{ .package }}

{{- if hasKey . "completions_cmd" }}
{{ template "common/script_validate_completions_path" $ }}
{{ .completions_cmd }} > "$HOME/.local/share/zsh/site-functions/_{{ .name }}"
{{- end }}
{{- end }}
{{- end }}

{{- /* Install CURL tools */ -}}
{{ range .ai_tools.curl }}
{{- $featureEnabled := false -}}
{{- if eq .feature_flag "harness" }}{{ $featureEnabled = $.features.ai.harness }}{{- end -}}
{{- if eq .feature_flag "harness_tools" }}{{ $featureEnabled = $.features.ai.harness_tools }}{{- end -}}
{{- if eq .feature_flag "spec_tools" }}{{ $featureEnabled = $.features.ai.spec_tools }}{{- end -}}
{{- if eq .feature_flag "multiplexer" }}{{ $featureEnabled = $.features.ai.multiplexer }}{{- end -}}
{{- if eq .feature_flag "composio.install" }}{{ $featureEnabled := and (not $.settings.vps ) ($.features.hermes.enabled) ($.features.hermes.composio.enabled) }}{{- end -}}
{{- $blocked := false -}}
{{- if and (hasKey . "block_on_workplace") (eq .block_on_workplace $.settings.workplace) }}{{ $blocked = true }}{{- end -}}

{{ if and $featureEnabled (not $blocked) }}
info ">>>> Installing {{ .name }} (Curl) <<<<<<"
{{ if hasKey . "env" }}{{ .env }} {{ end }}curl -fsSL {{ .url }} | {{ .shell }}
{{- end }}
{{- end }}

{{- /* Install Github tools */ -}}
{{ range .ai_tools.github }}
{{- $featureEnabled := false -}}
{{- if eq .feature_flag "harness" }}{{ $featureEnabled = $.features.ai.harness }}{{- end -}}
{{- if eq .feature_flag "harness_tools" }}{{ $featureEnabled = $.features.ai.harness_tools }}{{- end -}}
{{- if eq .feature_flag "spec_tools" }}{{ $featureEnabled = $.features.ai.spec_tools }}{{- end -}}
{{- if eq .feature_flag "multiplexer" }}{{ $featureEnabled = $.features.ai.multiplexer }}{{- end -}}
{{- if eq .feature_flag "composio.install" }}{{ $featureEnabled := and (not $.settings.vps ) ($.features.hermes.enabled) ($.features.hermes.composio.enabled) }}{{- end -}}
{{- $blocked := false -}}
{{- if and (hasKey . "block_on_workplace") (eq .block_on_workplace $.settings.workplace) }}{{ $blocked = true }}{{- end -}}

{{ if and $featureEnabled (not $blocked) }}
info ">>>> Installing {{ .name }} (Github 🐙) <<<<<<"
{{- $path := (joinPath $chezmoi.homeDir ".local" "src" .name) }}
if [ ! -d {{ $path }} ]; then
    {{ if hasKey . "env" }}{{ .env }} {{ end }}git clone {{ .url }} {{ $path }}
else
    cd {{ $path }}
    git pull origin
fi
{{- end }}
{{- end }}

success ">>> 🤖 AI Tools Installed 🤖"

# vim: filetype=bash
