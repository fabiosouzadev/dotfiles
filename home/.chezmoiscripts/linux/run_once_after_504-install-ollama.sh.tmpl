#!/usr/bin/env bash

{{ template "common/script_helper" . -}}
{{ template "common/script_release_helpers" . -}}
{{ template "linux/script_linux_only" . -}}
{{ template "common/script_is_not_ephemeral" . -}}
{{ template "workplace/script_is_not_vps" . }}

{{- if .features.ollama.install }}

info ">>> 🐑 Installing Ollama in mode {{ .features.ollama.mode }}  🐑"

# --------------------------------------------------------------------
# USER MODE (WSL / ambiente gerenciado)
# --------------------------------------------------------------------
{{-  if eq .features.ollama.mode "user" }}

INSTALL_DIR="{{ .dirs.local }}"
LOG_DIR="{{ .features.ollama.path.logs }}"
SRC_DIR="{{ .dirs.src }}"

{{- if eq .features.ollama.version "latest" }}
OLLAMA_VERSION=$(github_latest_tag ollama/ollama) || exit 1
{{- else }}
OLLAMA_VERSION="{{ .features.ollama.version }}"
{{- end }}

# Remove apenas binários e libs; preserva modelos e chave de identidade
# ~/.ollama/models e ~/.ollama/id_ed25519* são mantidos (M4)
rm -f "$INSTALL_DIR/bin/ollama"
rm -rf "$INSTALL_DIR/lib/ollama"

# zstd é necessário para extrair o arquivo .tar.zst
# Upstream não publica binário Linux (URL antiga retornava 404 em 2026-11-24)
if ! command -v zstd >/dev/null 2>&1; then
  error "zstd is required to extract the Ollama .tar.zst archive; install it with your package manager (apt install zstd / pacman -S zstd) and run chezmoi apply again"
  exit 1
fi

mkdir -p "$INSTALL_DIR" "$SRC_DIR"
cd "$SRC_DIR"

export PATH="${INSTALL_DIR}/bin:${PATH}"

if ! curl -fsSL "https://github.com/ollama/ollama/releases/download/${OLLAMA_VERSION}/ollama-linux-amd64.tar.zst" -o ollama-linux-amd64.tar.zst; then
  error "Failed to download Ollama ${OLLAMA_VERSION}"
  exit 1
fi
tar --zstd -xvf ollama-linux-amd64.tar.zst -C "${INSTALL_DIR}"

export PATH="${INSTALL_DIR}/bin:${PATH}"
export LD_LIBRARY_PATH="${INSTALL_DIR}/lib/ollama:${LD_LIBRARY_PATH:-}"

mkdir -p "$LOG_DIR"

if {{ .features.runtime.background_services }}; then
  nohup ollama serve > "$LOG_DIR/server.log" 2>&1 &
  success "Ollama rodando em background"
else
  warn "Background desabilitado — execute manualmente: ollama serve"
fi

success "🐑 Ollama Installed in $INSTALL_DIR version: $(ollama -v) 🐑 "

# --------------------------------------------------------------------
# ROOT MODE
# --------------------------------------------------------------------

{{-  else if eq .features.ollama.mode "root" }}

{{ if .features.systemd.enabled }}
# Tolerante à primeira instalação (unit não existe ainda)
sudo systemctl stop ollama 2>/dev/null || true
sudo systemctl disable ollama 2>/dev/null || true

if [ -f /etc/systemd/system/ollama.service ]; then
  sudo rm /etc/systemd/system/ollama.service
fi
{{ end }}

info " 🐑 Instalando Ollama 🐑 "
curl -fsSL https://ollama.com/install.sh | sh

{{ if .features.systemd.enabled }}
sudo systemctl daemon-reload
sudo systemctl enable --now ollama
{{ end }}

success "Ollama Installed version: $(ollama -v) 🐑"

{{- end }}

### Override Service
{{- if not (eq .features.ollama.mode "user")}}

[ -d /etc/systemd/system/ollama.service.d ] || sudo mkdir /etc/systemd/system/ollama.service.d/

# Reescreve o override em toda execução (tee sem -a)
sudo tee /etc/systemd/system/ollama.service.d/override.conf > /dev/null <<'EOF'
[Service]
{{ range .features.ollama.environments -}}
Environment={{.}}
{{ end -}}

# Prioridade de CPU para evitar travamentos
Nice=-5
CPUSchedulingPolicy=rr
CPUSchedulingPriority=1

# Limites de memória realistas para 16GB
MemoryHigh=12G
MemoryMax=14G
MemorySwapMax=4G

EOF

sudo systemctl daemon-reload
sudo systemctl enable --now ollama.service
success "✨ Seu setup de IA local está 100% otimizado para alto desempenho!"

sleep 3

{{- end }}

{{- end }}