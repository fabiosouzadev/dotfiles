def score_job(job_content: str) -> dict:
    """
    Faz scoring da vaga.
    Em produção, chama LLM via OmniRoute. Aqui retorna mock para desenvolvimento.
    """
    
    keywords = extract_keywords(job_content)
    email = find_email_in_text(job_content)
    
    # Scoring heurístico baseado em keywords
    score = 0
    details = {
        "stack_match": 0,
        "contract_remote": 0,
        "seniority": 0,
        "fintech": 0,
        "ai_llm": 0
    }
    
    # 1. Stack Match (30 pts)
    core_stacks = ["node.js", "nestjs", "java", "spring boot", "python", "django"]
    matched_stacks = [s for s in core_stacks if s in [k.lower() for k in keywords['stack']]]
    if len(matched_stacks) >= 2:
        details["stack_match"] = 30
    elif len(matched_stacks) == 1:
        details["stack_match"] = 15
    
    # 2. Contrato + Remoto (25 pts)
    if keywords['contract'] == 'pj' and keywords['remote']:
        details["contract_remote"] = 25
    elif keywords['contract'] == 'pj' and not keywords['remote']:
        details["contract_remote"] = 20  # Híbrido (assumir Londrina se não especificado)
    elif keywords['contract'] == 'clt' and keywords['remote']:
        details["contract_remote"] = 10
    
    # 3. Senioridade (20 pts)
    if keywords['seniority'] == 'tech_lead':
        details["seniority"] = 20
    elif keywords['seniority'] == 'architect':
        details["seniority"] = 18
    elif keywords['seniority'] == 'senior':
        details["seniority"] = 15
    elif keywords['seniority'] == 'pleno':
        details["seniority"] = 5
    
    # 4. Fintech (15 pts)
    if keywords['domain']:
        details["fintech"] = 15
    elif any(x in job_content.lower() for x in ['banco', 'banking', 'financeiro', 'finance']):
        details["fintech"] = 10
    
    # 5. IA/LLMs (10 pts)
    if keywords['ai']:
        details["ai_llm"] = 10
    elif any(x in job_content.lower() for x in ['ai', 'ml', 'machine learning', 'inteligência artificial']):
        details["ai_llm"] = 5
    
    # Penalidades
    red_flags = []
    if keywords['contract'] == 'clt' and not keywords['remote']:
        if 'londrina' not in job_content.lower():
            red_flags.append("CLT presencial fora de Londrina")
            score = 0  # Hard requirement
    
    if keywords['seniority'] in ['junior', 'pleno'] and keywords['seniority'] not in ['tech_lead', 'architect']:
        red_flags.append("Júnior/Pleno sem liderança")
        # Não zera, mas penaliza
    
    score = sum(details.values())
    
    # Bonus por empresa conhecida, salário público, recrutador direto
    # (implementar depois se necessário)
    
    return {
        "score": min(score, 100),
        "details": details,
        "reasoning": f"Stack: {matched_stacks}, Contrato: {keywords['contract']}, Remoto: {keywords['remote']}, Senioridade: {keywords['seniority']}, Fintech: {bool(keywords['domain'])}, IA: {bool(keywords['ai'])}",
        "matched_keywords": keywords,
        "email_found": email,
        "red_flags": red_flags
    }


if __name__ == "__main__":
    if len(sys.argv) > 1:
        # Ler conteúdo de arquivo ou stdin
        if sys.argv[1] == '-':
            content = sys.stdin.read()
        else:
            with open(sys.argv[1], 'r') as f:
                content = f.read()
        result = score_job(content)
        print(json.dumps(result, ensure_ascii=False, indent=2))