#!/usr/bin/env python3
"""
LinkedIn Daily Jobs Search Script
Searches LinkedIn via Camofox API, extracts structured job data using JSON Schema with x-ref,
formats results as Markdown, and sends to Telegram.
"""

import argparse
import json
import sys
import time
import urllib.request
import urllib.error
from datetime import datetime
from pathlib import Path
from typing import Any, Dict, List, Optional

import urllib.parse


class CamofoxClient:
    def __init__(self, base_url: str, api_key: str, user_id: str):
        self.base_url = base_url.rstrip('/')
        self.api_key = api_key
        self.user_id = user_id
        self.session_key = "linkedin-jobs-search"
        
    def _request(self, method: str, endpoint: str, data: Optional[Dict] = None) -> Dict:
        url = f"{self.base_url}{endpoint}"
        headers = {
            'Authorization': f'Bearer {self.api_key}',
            'Content-Type': 'application/json',
        }
        
        if data is not None:
            body = json.dumps(data).encode('utf-8')
        else:
            body = None
            
        req = urllib.request.Request(url, data=body, method=method, headers=headers)
        
        try:
            with urllib.request.urlopen(req, timeout=60) as response:
                return json.loads(response.read().decode('utf-8'))
        except urllib.error.HTTPError as e:
            error_body = e.read().decode('utf-8')
            raise Exception(f"HTTP {e.code}: {error_body}")
        except urllib.error.URLError as e:
            raise Exception(f"Connection error: {e.reason}")
    
    def health_check(self) -> Dict:
        return self._request('GET', '/health')
    
    def import_cookies(self, cookies: List[Dict]) -> Dict:
        return self._request('POST', f'/sessions/{self.user_id}/cookies', {"cookies": cookies})
    
    def create_tab(self, url: str = "https://www.linkedin.com/feed/") -> Dict:
        return self._request('POST', '/tabs', {
            "userId": self.user_id,
            "sessionKey": self.session_key,
            "url": url
        })
    
    def navigate(self, tab_id: str, url: str) -> Dict:
        return self._request('POST', f'/tabs/{tab_id}/navigate', {
            "userId": self.user_id,
            "url": url,
            "sessionKey": self.session_key
        })
    
    def wait_for_selector(self, tab_id: str, selector: str, timeout: int = 60000) -> Dict:
        return self._request('POST', f'/tabs/{tab_id}/wait', {
            "userId": self.user_id,
            "selector": selector,
            "timeout": timeout
        })
    
    def snapshot(self, tab_id: str, format: str = "text") -> Dict:
        return self._request('GET', f'/tabs/{tab_id}/snapshot?userId={self.user_id}&format={format}')
    
    def extract(self, tab_id: str, schema: Dict) -> Dict:
        return self._request('POST', f'/tabs/{tab_id}/extract', {
            "userId": self.user_id,
            "schema": schema
        })
    
    def click(self, tab_id: str, ref: str) -> Dict:
        return self._request('POST', f'/tabs/{tab_id}/click', {
            "userId": self.user_id,
            "ref": ref
        })
    
    def scroll(self, tab_id: str, direction: str = "down", amount: int = 3) -> Dict:
        return self._request('POST', f'/tabs/{tab_id}/scroll', {
            "userId": self.user_id,
            "direction": direction,
            "amount": amount
        })
    
    def close_tab(self, tab_id: str) -> Dict:
        return self._request('DELETE', f'/tabs/{tab_id}?userId={self.user_id}')
    
    def close_session(self) -> Dict:
        return self._request('DELETE', f'/sessions/{self.user_id}')


def parse_netscape_cookies(cookie_file: Path) -> List[Dict]:
    """Parse Netscape format cookie file and return LinkedIn cookies in Camofox format."""
    cookies = []
    with open(cookie_file) as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith('#'):
                continue
            parts = line.split('\t')
            if len(parts) >= 7 and 'linkedin.com' in parts[0]:
                domain = parts[0].lstrip('.')
                cookies.append({
                    "name": parts[5],
                    "value": parts[6].strip('"'),
                    "domain": domain,
                    "path": parts[2],
                    "expires": int(parts[4]),
                    "httpOnly": True,
                    "secure": parts[3] == 'TRUE',
                    "sameSite": "Lax"
                })
    return cookies


JOB_SEARCH_SCHEMA = {
    "type": "object",
    "properties": {
        "jobs": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "title": {"type": "string", "x-ref": "e1"},
                    "company": {"type": "string", "x-ref": "e2"},
                    "location": {"type": "string", "x-ref": "e3"},
                    "posted_time": {"type": "string", "x-ref": "e4"},
                    "description_preview": {"type": "string", "x-ref": "e5"},
                    "job_url": {"type": "string", "x-ref": "e6"},
                    "salary_range": {"type": "string", "x-ref": "e7"},
                    "work_type": {"type": "string", "x-ref": "e8"}
                },
                "required": ["title", "company", "location", "job_url"]
            }
        }
    },
    "required": ["jobs"]
}


def search_linkedin_jobs(client: CamofoxClient, query: str = "software engineer", location: str = "remote") -> List[Dict]:
    """
    Search LinkedIn for jobs using the jobs search URL.
    LinkedIn jobs search URL format: https://www.linkedin.com/jobs/search/?keywords=QUERY&location=LOCATION
    """
    # Create tab
    print("Creating browser tab...")
    tab_result = client.create_tab("https://www.linkedin.com/feed/")
    tab_id = tab_result.get('tabId')
    if not tab_id:
        raise Exception(f"Failed to create tab: {tab_result}")
    print(f"Tab created: {tab_id}")
    
    try:
        # Import cookies first
        cookie_file = Path("/opt/data/camofox-data/cookies/linkedin.txt")
        if cookie_file.exists():
            print("Importing LinkedIn cookies...")
            cookies = parse_netscape_cookies(cookie_file)
            linkedin_cookies = [c for c in cookies if 'linkedin.com' in c['domain']]
            if linkedin_cookies:
                result = client.import_cookies(linkedin_cookies)
                print(f"Imported {len(linkedin_cookies)} LinkedIn cookies: {result}")
            else:
                print("No LinkedIn cookies found in file")
        else:
            print(f"Cookie file not found: {cookie_file}")
        
        # Navigate to jobs search
        search_url = f"https://www.linkedin.com/jobs/search/?keywords={urllib.parse.quote(query)}&location={urllib.parse.quote(location)}"
        print(f"Navigating to: {search_url}")
        client.navigate(tab_id, search_url)
        
        # Wait for job cards to load
        print("Waiting for job listings to load...")
        try:
            client.wait_for_selector(tab_id, "[data-job-id], .job-card-container, .jobs-search-results__list", timeout=60000)
        except Exception as e:
            print(f"Wait for selector timeout (may be blocked): {e}")
        
        # Give more time for rendering
        time.sleep(5)
        
        # Get snapshot to populate refs
        print("Taking accessibility snapshot...")
        snapshot = client.snapshot(tab_id, format="text")
        refs_count = snapshot.get('refsCount', 0)
        total_chars = snapshot.get('totalChars', 0)
        print(f"Snapshot: {refs_count} refs, {total_chars} chars")
        
        if total_chars < 1000:
            print("WARNING: Page appears to be blocked (empty content)")
            # Try to get screenshot for debugging
            return []
        
        # Extract structured job data
        print("Extracting job data...")
        result = client.extract(tab_id, JOB_SEARCH_SCHEMA)
        
        if 'result' in result:
            jobs = result['result'].get('jobs', [])
            print(f"Extracted {len(jobs)} jobs")
            return jobs
        else:
            print(f"Extraction failed: {result}")
            return []
            
    finally:
        # Clean up
        try:
            client.close_tab(tab_id)
        except:
            pass


def format_jobs_markdown(jobs: List[Dict], query: str, location: str) -> str:
    """Format extracted jobs as Markdown for Telegram."""
    if not jobs:
        return f"🔍 *LinkedIn Daily Jobs Search*\n\n*Query:* {query}\n*Location:* {location}\n\n❌ No jobs found or LinkedIn blocked the request.\n\n*Time:* {datetime.now().strftime('%Y-%m-%d %H:%M UTC')}"
    
    lines = [
        f"🔍 *LinkedIn Daily Jobs Search*",
        f"",
        f"*Query:* {query}",
        f"*Location:* {location}",
        f"*Found:* {len(jobs)} jobs",
        f"*Time:* {datetime.now().strftime('%Y-%m-%d %H:%M UTC')}",
        f"",
        f"---",
        f""
    ]
    
    for i, job in enumerate(jobs[:10], 1):  # Limit to 10 jobs for Telegram
        lines.append(f"### {i}. {job.get('title', 'N/A')}")
        lines.append(f"**Company:** {job.get('company', 'N/A')}")
        lines.append(f"**Location:** {job.get('location', 'N/A')}")
        
        if job.get('posted_time'):
            lines.append(f"**Posted:** {job['posted_time']}")
        if job.get('salary_range'):
            lines.append(f"**Salary:** {job['salary_range']}")
        if job.get('work_type'):
            lines.append(f"**Type:** {job['work_type']}")
        
        if job.get('description_preview'):
            desc = job['description_preview'][:200]
            lines.append(f"**Preview:** {desc}...")
        
        if job.get('job_url'):
            lines.append(f"[🔗 View on LinkedIn]({job['job_url']})")
        
        lines.append("")
        lines.append("---")
        lines.append("")
    
    if len(jobs) > 10:
        lines.append(f"*... and {len(jobs) - 10} more jobs*")
    
    return "\n".join(lines)


def send_telegram_message(token: str, chat_id: str, text: str, parse_mode: str = "Markdown") -> bool:
    """Send message to Telegram."""
    url = f"https://api.telegram.org/bot{token}/sendMessage"
    data = {
        "chat_id": chat_id,
        "text": text,
        "parse_mode": parse_mode,
        "disable_web_page_preview": True
    }
    
    body = urllib.parse.urlencode(data).encode('utf-8')
    req = urllib.request.Request(url, data=body, method='POST')
    req.add_header('Content-Type', 'application/x-www-form-urlencoded')
    
    try:
        with urllib.request.urlopen(req, timeout=30) as response:
            result = json.loads(response.read().decode('utf-8'))
            return result.get('ok', False)
    except Exception as e:
        print(f"Telegram send failed: {e}")
        return False


def main():
    parser = argparse.ArgumentParser(description='LinkedIn Daily Jobs Search via Camofox')
    parser.add_argument('--camofox-url', default='http://localhost:9377', help='Camofox API URL')
    parser.add_argument('--api-key', required=True, help='Camofox API key')
    parser.add_argument('--user-id', default='fabio', help='User ID for Camofox session')
    parser.add_argument('--telegram-token', required=True, help='Telegram Bot Token')
    parser.add_argument('--telegram-chat-id', default='644615401', help='Telegram Chat ID')
    parser.add_argument('--query', default='software engineer', help='Job search query')
    parser.add_argument('--location', default='remote', help='Job location')
    parser.add_argument('--test-only', action='store_true', help='Only test Camofox connection')
    
    args = parser.parse_args()
    
    # Initialize client
    client = CamofoxClient(args.camofox_url, args.api_key, args.user_id)
    
    # Health check
    print("Checking Camofox health...")
    try:
        health = client.health_check()
        print(f"Health: {health}")
        if not health.get('browserConnected') or not health.get('browserRunning'):
            print("ERROR: Browser not connected or not running")
            send_telegram_message(
                args.telegram_token, 
                args.telegram_chat_id,
                f"⚠️ *LinkedIn Jobs Search Failed*\n\nCamofox browser not running. Please start the Camofox container.\n\nTime: {datetime.now().strftime('%Y-%m-%d %H:%M UTC')}"
            )
            sys.exit(1)
    except Exception as e:
        print(f"Health check failed: {e}")
        send_telegram_message(
            args.telegram_token,
            args.telegram_chat_id,
            f"⚠️ *LinkedIn Jobs Search Failed*\n\nCannot connect to Camofox at {args.camofox_url}: {e}\n\nTime: {datetime.now().strftime('%Y-%m-%d %H:%M UTC')}"
        )
        sys.exit(1)
    
    if args.test_only:
        print("Health check passed. Test mode only.")
        return
    
    # Search for jobs
    print(f"Searching for '{args.query}' in '{args.location}'...")
    jobs = search_linkedin_jobs(client, args.query, args.location)
    
    # Format and send results
    markdown = format_jobs_markdown(jobs, args.query, args.location)
    print("Sending to Telegram...")
    
    success = send_telegram_message(args.telegram_token, args.telegram_chat_id, markdown)
    if success:
        print("Message sent successfully!")
    else:
        print("Failed to send message")
        sys.exit(1)


if __name__ == '__main__':
    main()
