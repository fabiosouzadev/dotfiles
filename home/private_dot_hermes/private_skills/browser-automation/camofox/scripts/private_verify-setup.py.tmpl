#!/usr/bin/env python3
"""
Verify Camofox setup and health.

Usage:
    python scripts/verify-setup.py [--host http://camofox:9377] [--api-key KEY] [--user-id hermes]

Checks:
    1. Health endpoint
    2. Cookie import capability
    3. example.com loads correctly (control test)
    4. Screenshot is not black (15KB indicates blocking)
    5. Snapshot returns refs > 0
"""

import argparse
import json
import os
import sys
import time
import urllib.request
from typing import Optional


def http_request(url: str, method: str = 'GET', data: dict = None, headers: dict = None) -> dict:
    """Make HTTP request and return JSON response."""
    req_data = json.dumps(data).encode('utf-8') if data else None
    req_headers = {'Content-Type': 'application/json'}
    if headers:
        req_headers.update(headers)
    
    req = urllib.request.Request(url, data=req_data, method=method, headers=req_headers)
    response = urllib.request.urlopen(req)
    return json.loads(response.read().decode('utf-8'))


def check_health(host: str) -> bool:
    """Check health endpoint."""
    print("1. Checking health endpoint...")
    try:
        result = http_request(f"{host}/health")
        ok = result.get('ok', False) and result.get('browserConnected', False) and result.get('browserRunning', False)
        print(f"   Health: {result}")
        return ok
    except Exception as e:
        print(f"   FAILED: {e}")
        return False


def check_cookie_import(host: str, api_key: str, user_id: str) -> bool:
    """Test cookie import with dummy cookie."""
    print("2. Testing cookie import...")
    try:
        # Use a harmless test cookie
        test_cookies = [{
            "name": "test_cookie",
            "value": "test_value",
            "domain": "example.com",
            "path": "/",
            "expires": int(time.time()) + 3600,
            "httpOnly": False,
            "secure": True,
            "sameSite": "Lax"
        }]
        result = http_request(
            f"{host}/sessions/{user_id}/cookies",
            method='POST',
            data={"cookies": test_cookies},
            headers={'Authorization': f'Bearer {api_key}'}
        )
        ok = result.get('ok', False) and result.get('count', 0) == 1
        print(f"   Cookie import: {result}")
        return ok
    except Exception as e:
        print(f"   FAILED: {e}")
        return False


def check_example_com(host: str, api_key: str, user_id: str) -> bool:
    """Test loading example.com as control."""
    print("3. Testing example.com (control)...")
    try:
        # Create tab
        tab_result = http_request(
            f"{host}/tabs",
            method='POST',
            data={"userId": user_id, "sessionKey": "verify-test", "url": "https://example.com"},
            headers={'Authorization': f'Bearer {api_key}'}
        )
        tab_id = tab_result.get('tabId')
        if not tab_id:
            print(f"   FAILED: No tabId returned: {tab_result}")
            return False
        
        # Wait for load
        time.sleep(5)
        
        # Wait for body
        http_request(
            f"{host}/tabs/{tab_id}/wait",
            method='POST',
            data={"userId": user_id, "selector": "body", "timeout": 30000},
            headers={'Authorization': f'Bearer {api_key}'}
        )
        
        # Get snapshot
        snap_result = http_request(
            f"{host}/tabs/{tab_id}/snapshot?userId={user_id}&format=text",
            headers={'Authorization': f'Bearer {api_key}'}
        )
        
        refs = snap_result.get('refsCount', 0)
        total_chars = snap_result.get('totalChars', 0)
        url = snap_result.get('url', '')
        
        print(f"   Snapshot: url={url}, refs={refs}, chars={total_chars}")
        
        # Get screenshot
        screenshot_url = f"{host}/tabs/{tab_id}/screenshot?userId={user_id}"
        req = urllib.request.Request(screenshot_url, method='GET', headers={'Authorization': f'Bearer {api_key}'})
        response = urllib.request.urlopen(req)
        screenshot_data = response.read()
        screenshot_size = len(screenshot_data)
        
        print(f"   Screenshot: {screenshot_size} bytes")
        
        # Cleanup
        http_request(
            f"{host}/tabs/{tab_id}?userId={user_id}",
            method='DELETE',
            headers={'Authorization': f'Bearer {api_key}'}
        )
        
        # Verify: refs > 0, chars > 0, screenshot ~30KB (not 15KB black)
        success = refs > 0 and total_chars > 0 and screenshot_size > 20000
        if not success:
            print(f"   FAILED: refs={refs}, chars={total_chars}, screenshot={screenshot_size} bytes")
        return success
        
    except Exception as e:
        print(f"   FAILED: {e}")
        return False


def main():
    parser = argparse.ArgumentParser(description='Verify Camofox setup')
    parser.add_argument('--host', default=os.getenv('CAMOFOX_HOST', 'http://camofox:9377'),
                        help='Camofox server URL')
    parser.add_argument('--api-key', default=os.getenv('CAMOFOX_API_KEY'),
                        help='API key (default: CAMOFOX_API_KEY env var)')
    parser.add_argument('--user-id', default=os.getenv('CAMOFOX_USER_ID', 'hermes'),
                        help='User ID (default: hermes)')
    args = parser.parse_args()
    
    if not args.api_key:
        parser.error("API key required. Set CAMOFOX_API_KEY env var or use --api-key")
    
    print(f"Verifying Camofox at {host}")
    print(f"User ID: {args.user_id}")
    print()
    
    checks = [
        ("Health Check", check_health(args.host)),
        ("Cookie Import", check_cookie_import(args.host, args.api_key, args.user_id)),
        ("Example.com Load", check_example_com(args.host, args.api_key, args.user_id)),
    ]
    
    print()
    print("=" * 50)
    print("SUMMARY")
    print("=" * 50)
    
    all_passed = True
    for name, result in checks:
        status = "PASS" if result else "FAIL"
        print(f"  {name}: {status}")
        if not result:
            all_passed = False
    
    if all_passed:
        print("\n✓ All checks passed!")
        sys.exit(0)
    else:
        print("\n✗ Some checks failed")
        sys.exit(1)


if __name__ == '__main__':
    main()