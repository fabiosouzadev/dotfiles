#!/usr/bin/env python3
"""
Import cookies from Netscape format file into Camofox session.

Usage:
    python scripts/import-cookies.py linkedin.txt [--user-id hermes] [--api-key KEY]

Environment variables:
    CAMOFOX_API_KEY - Bearer token for authentication
    CAMOFOX_USER_ID - Default user ID (default: hermes)
    CAMOFOX_HOST - Camofox server URL (default: http://camofox:9377)
"""

import argparse
import json
import os
import sys
import urllib.request
from pathlib import Path


def parse_netscape_cookies(cookie_file: str, domain_filter: str = None) -> list:
    """Parse Netscape format cookie file."""
    cookies = []
    with open(cookie_file, 'r') as f:
        for line_num, line in enumerate(f, 1):
            line = line.strip()
            if not line or line.startswith('#'):
                continue
            parts = line.split('\t')
            if len(parts) < 7:
                print(f"Warning: Line {line_num} has insufficient fields, skipping", file=sys.stderr)
                continue
            
            domain = parts[0].lstrip('.')
            if domain_filter and domain_filter not in domain:
                continue
            
            # Remove surrounding quotes from value
            value = parts[6]
            if value.startswith('"') and value.endswith('"'):
                value = value[1:-1]
            
            cookies.append({
                "name": parts[5],
                "value": value,
                "domain": domain,
                "path": parts[2],
                "expires": int(parts[4]),
                "httpOnly": True,
                "secure": parts[3] == 'TRUE',
                "sameSite": "Lax"
            })
    return cookies


def import_cookies(cookies: list, user_id: str, api_key: str, host: str) -> dict:
    """Import cookies via Camofox API."""
    url = f"{host}/sessions/{user_id}/cookies"
    data = json.dumps({"cookies": cookies}).encode('utf-8')
    
    req = urllib.request.Request(url, data=data, method='POST')
    req.add_header('Content-Type', 'application/json')
    req.add_header('Authorization', f'Bearer {api_key}')
    
    try:
        response = urllib.request.urlopen(req)
        return json.loads(response.read().decode('utf-8'))
    except urllib.error.HTTPError as e:
        error_body = e.read().decode('utf-8')
        raise RuntimeError(f"HTTP {e.code}: {error_body}") from e


def main():
    parser = argparse.ArgumentParser(description='Import cookies into Camofox')
    parser.add_argument('cookie_file', help='Netscape format cookie file')
    parser.add_argument('--user-id', default=os.getenv('CAMOFOX_USER_ID', 'hermes'),
                        help='User ID for session (default: hermes)')
    parser.add_argument('--api-key', default=os.getenv('CAMOFOX_API_KEY'),
                        help='API key (default: CAMOFOX_API_KEY env var)')
    parser.add_argument('--host', default=os.getenv('CAMOFOX_HOST', 'http://camofox:9377'),
                        help='Camofox server URL (default: http://camofox:9377)')
    parser.add_argument('--domain', help='Filter cookies by domain (e.g. linkedin.com)')
    args = parser.parse_args()
    
    if not args.api_key:
        parser.error("API key required. Set CAMOFOX_API_KEY env var or use --api-key")
    
    if not Path(args.cookie_file).exists():
        parser.error(f"Cookie file not found: {args.cookie_file}")
    
    print(f"Parsing cookies from {args.cookie_file}...")
    cookies = parse_netscape_cookies(args.cookie_file, args.domain)
    print(f"Found {len(cookies)} cookies" + (f" for domain {args.domain}" if args.domain else ""))
    
    if not cookies:
        print("No cookies to import", file=sys.stderr)
        sys.exit(1)
    
    print(f"Importing into Camofox session for user '{args.user_id}'...")
    result = import_cookies(cookies, args.user_id, args.api_key, args.host)
    
    print(f"Success: {json.dumps(result, indent=2)}")


if __name__ == '__main__':
    main()