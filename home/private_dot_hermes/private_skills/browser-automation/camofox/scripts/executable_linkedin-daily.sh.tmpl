#!/usr/bin/env bash
# LinkedIn Daily Jobs Search Script
# Searches LinkedIn via Camofox API, extracts job data using JSON Schema with x-ref,
# formats as Markdown, and sends to Telegram.

set -euo pipefail

# Configuration from environment
CAMOFOX_URL="${CAMOFOX_URL:-http://localhost:9377}"
CAMOFOX_API_KEY="${CAMOFOX_API_KEY:-}"
TELEGRAM_BOT_TOKEN="${TELEGRAM_BOT_TOKEN:-}"
TELEGRAM_CHAT_ID="${TELEGRAM_CHAT_ID:-}"
USER_ID="${USER_ID:-fabio}"
SEARCH_QUERY="${SEARCH_QUERY:-backend python remote}"
MAX_JOBS="${MAX_JOBS:-10}"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

log() { echo -e "${GREEN}[$(date '+%H:%M:%S')]${NC} $*"; }
warn() { echo -e "${YELLOW}[$(date '+%H:%M:%S')] WARNING:${NC} $*"; }
err() { echo -e "${RED}[$(date '+%H:%M:%S')] ERROR:${NC} $*" >&2; }

# Check required environment
check_env() {
    local missing=()
    [[ -z "$CAMOFOX_API_KEY" ]] && missing+=("CAMOFOX_API_KEY")
    [[ -z "$TELEGRAM_BOT_TOKEN" ]] && missing+=("TELEGRAM_BOT_TOKEN")
    [[ -z "$TELEGRAM_CHAT_ID" ]] && missing+=("TELEGRAM_CHAT_ID")
    
    if [[ ${#missing[@]} -gt 0 ]]; then
        err "Missing required environment variables: ${missing[*]}"
        return 1
    fi
}

# Send message to Telegram
send_telegram() {
    local message="$1"
    local parse_mode="${2:-Markdown}"
    
    curl -s -X POST "https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage" \
        -H "Content-Type: application/json" \
        -d "{\"chat_id\": \"${TELEGRAM_CHAT_ID}\", \"text\": $(jq -n --arg msg "$message" '$msg'), \"parse_mode\": \"${parse_mode}\"}" \
        > /dev/null
}

# Send message to Telegram (with markdown escaping)
send_telegram_md() {
    local message="$1"
    curl -s -X POST "https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage" \
        -H "Content-Type: application/json" \
        -d "{\"chat_id\": \"${TELEGRAM_CHAT_ID}\", \"text\": $(jq -n --arg msg "$message" '$msg'), \"parse_mode\": \"Markdown\"}" \
        > /dev/null
}

# HTTP request helper for Camofox API
camofox_request() {
    local method="$1"
    local endpoint="$2"
    local data="${3:-}"
    local user_id="${4:-$USER_ID}"
    
    local url="${CAMOFOX_URL}${endpoint}"
    local headers=(-H "Authorization: Bearer ${CAMOFOX_API_KEY}" -H "Content-Type: application/json")
    
    if [[ -n "$data" ]]; then
        curl -s -X "$method" "$url" "${headers[@]}" -d "$data"
    else
        curl -s -X "$method" "$url" "${headers[@]}"
    fi
}

# Check Camofox health
check_camofox() {
    log "Checking Camofox health at ${CAMOFOX_URL}..."
    local health
    health=$(curl -s -m 10 "${CAMOFOX_URL}/health" 2>/dev/null) || return 1
    
    local ok browser_connected browser_running
    ok=$(echo "$health" | jq -r '.ok // false')
    browser_connected=$(echo "$health" | jq -r '.browserConnected // false')
    browser_running=$(echo "$health" | jq -r '.browserRunning // false')
    
    if [[ "$ok" == "true" && "$browser_connected" == "true" && "$browser_running" == "true" ]]; then
        log "Camofox is healthy"
        return 0
    else
        err "Camofox health check failed: $health"
        return 1
    fi
}

# Import LinkedIn cookies
import_cookies() {
    local cookie_file="/opt/data/camofox-data/cookies/linkedin.txt"
    if [[ ! -f "$cookie_file" ]]; then
        warn "Cookie file not found: $cookie_file"
        return 1
    fi
    
    log "Importing LinkedIn cookies for user ${USER_ID}..."
    
    # Parse Netscape format cookies
    local cookies_json
    cookies_json=$(python3 -c "
import sys
cookies = []
with open('$cookie_file') as f:
    for line in f:
        line = line.strip()
        if not line or line.startswith('#'): continue
        parts = line.split('\t')
        if len(parts) < 7: continue
        domain = parts[0].lstrip('.')
        if 'linkedin.com' not in domain: continue
        value = parts[6]
        if value.startswith('\"') and value.endswith('\"'): value = value[1:-1]
        cookies.append({
            'name': parts[5], 'value': value, 'domain': domain,
            'path': parts[2], 'expires': int(parts[4]),
            'httpOnly': True, 'secure': parts[3] == 'TRUE', 'sameSite': 'Lax'
        })
import json
print(json.dumps({'cookies': cookies}))
")
    
    local result
    result=$(camofox_request POST "/sessions/${USER_ID}/cookies" "$cookies_json")
    local ok count
    ok=$(echo "$result" | jq -r '.ok // false')
    count=$(echo "$result" | jq -r '.count // 0')
    
    if [[ "$ok" == "true" ]]; then
        log "Imported $count cookies"
        return 0
    else
        err "Cookie import failed: $result"
        return 1
    fi
}

# Create tab and navigate to LinkedIn jobs
create_jobs_tab() {
    local query_encoded
    query_encoded=$(python3 -c "import urllib.parse; print(urllib.parse.quote('$SEARCH_QUERY'))")
    local url="https://www.linkedin.com/jobs/search/?keywords=${query_encoded}&origin=JOB_SEARCH_PAGE_JOB_FILTER"
    
    log "Creating tab for LinkedIn jobs search: $SEARCH_QUERY"
    
    local tab_data
    tab_data=$(jq -n --arg uid "$USER_ID" --arg sk "linkedin-jobs-$(date +%s)" --arg url "$url" \
        '{userId: $uid, sessionKey: $sk, url: $url}')
    
    local result
    result=$(camofox_request POST "/tabs" "$tab_data")
    local tab_id
    tab_id=$(echo "$result" | jq -r '.tabId // empty')
    
    if [[ -z "$tab_id" ]]; then
        err "Failed to create tab: $result"
        return 1
    fi
    
    log "Created tab: $tab_id"
    echo "$tab_id"
}

# Wait for page content
wait_for_content() {
    local tab_id="$1"
    log "Waiting for job listings to load..."
    
    # Wait for job cards to appear
    local wait_data
    wait_data=$(jq -n --arg uid "$USER_ID" \
        '{userId: $uid, selector: ".job-card-container, .jobs-search-results__list-item, [data-job-id]", timeout: 60000}')
    
    local result
    result=$(camofox_request POST "/tabs/${tab_id}/wait" "$wait_data")
    local ready
    ready=$(echo "$result" | jq -r '.ready // false')
    
    if [[ "$ready" == "true" ]]; then
        log "Content loaded"
        return 0
    else
        warn "Wait timed out or failed: $result"
        return 1
    fi
}

# Get accessibility snapshot
get_snapshot() {
    local tab_id="$1"
    log "Getting accessibility snapshot..."
    
    local result
    result=$(camofox_request GET "/tabs/${tab_id}/snapshot?userId=${USER_ID}&format=text")
    
    local total_chars refs_count
    total_chars=$(echo "$result" | jq -r '.totalChars // 0')
    refs_count=$(echo "$result" | jq -r '.refsCount // 0')
    
    if [[ "$total_chars" -eq 0 || "$refs_count" -eq 0 ]]; then
        warn "Empty snapshot (chars: $total_chars, refs: $refs_count) - likely blocked by LinkedIn"
        echo "$result" | jq -r '.url // "unknown"'
        return 1
    fi
    
    log "Snapshot: ${total_chars} chars, ${refs_count} refs"
    echo "$result"
}

# Extract job data using JSON Schema with x-ref
extract_jobs() {
    local tab_id="$1"
    log "Extracting job data..."
    
    # JSON Schema for job extraction with x-ref to element references
    local schema
    schema=$(cat << 'SCHEMA_EOF'
{
  "type": "object",
  "properties": {
    "jobs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {"type": "string", "x-ref": "e1"},
          "company": {"type": "string", "x-ref": "e2"},
          "location": {"type": "string", "x-ref": "e3"},
          "posted": {"type": "string", "x-ref": "e4"},
          "description_snippet": {"type": "string", "x-ref": "e5"},
          "job_url": {"type": "string", "x-ref": "e6"}
        },
        "required": ["title", "company", "location"]
      }
    }
  },
  "required": ["jobs"]
}
SCHEMA_EOF
)
    
    local extract_data
    extract_data=$(jq -n --arg uid "$USER_ID" --argjson schema "$schema" \
        '{userId: $uid, schema: $schema}')
    
    local result
    result=$(camofox_request POST "/tabs/${tab_id}/extract" "$extract_data")
    
    local jobs
    jobs=$(echo "$result" | jq -c '.jobs // []')
    echo "$jobs"
}

# Format jobs as Markdown
format_jobs_md() {
    local jobs_json="$1"
    local query="$2"
    
    local count
    count=$(echo "$jobs_json" | jq 'length')
    
    if [[ "$count" -eq 0 ]]; then
        echo "🔍 *LinkedIn Daily Jobs Search*\n\n*Query:* \`$query\`\n*Results:* No jobs found (or page blocked by LinkedIn anti-bot)\n\n_This may be due to LinkedIn's bot detection. Consider using LinkedIn API or manual search._"
        return
    fi
    
    local md="🔍 *LinkedIn Daily Jobs Search*\n\n*Query:* \`$query\`\n*Found:* $count job(s)\n\n"
    
    local i=0
    while [[ $i -lt $count && $i -lt $MAX_JOBS ]]; do
        local title company location posted desc url
        title=$(echo "$jobs_json" | jq -r ".[$i].title // \"N/A\"" | sed 's/[*_`]/\\&/g')
        company=$(echo "$jobs_json" | jq -r ".[$i].company // \"N/A\"" | sed 's/[*_`]/\\&/g')
        location=$(echo "$jobs_json" | jq -r ".[$i].location // \"N/A\"" | sed 's/[*_`]/\\&/g')
        posted=$(echo "$jobs_json" | jq -r ".[$i].posted // \"\"" | sed 's/[*_`]/\\&/g')
        desc=$(echo "$jobs_json" | jq -r ".[$i].description_snippet // \"\"" | sed 's/[*_`]/\\&/g' | cut -c1-100)
        url=$(echo "$jobs_json" | jq -r ".[$i].job_url // \"\"")
        
        md+="$((i+1)). *$title*\n   🏢 $company | 📍 $location"
        [[ -n "$posted" ]] && md+=" | 📅 $posted"
        md+="\n"
        [[ -n "$desc" ]] && md+="   _$desc..._\n"
        [[ -n "$url" ]] && md+="   [View Job]($url)\n"
        md+="\n"
        
        ((i++))
    done
    
    md+="---\n_Source: LinkedIn via Camofox | $(date '+%Y-%m-%d %H:%M')_"
    echo "$md"
}

# Close tab
close_tab() {
    local tab_id="$1"
    camofox_request DELETE "/tabs/${tab_id}?userId=${USER_ID}" > /dev/null 2>&1 || true
}

# Main execution
main() {
    log "Starting LinkedIn daily jobs search..."
    log "Query: $SEARCH_QUERY"
    log "User: $USER_ID"
    
    # Check environment
    if ! check_env; then
        send_telegram_md "❌ *LinkedIn Jobs Search Failed*\n\nMissing required environment variables."
        exit 1
    fi
    
    # Check Camofox
    if ! check_camofox; then
        send_telegram_md "❌ *LinkedIn Jobs Search Failed*\n\nCamofox is not available at \`${CAMOFOX_URL}\`.\nPlease ensure the Camofox container is running on port 9377."
        exit 1
    fi
    
    # Import cookies
    if ! import_cookies; then
        warn "Cookie import failed, continuing anyway..."
    fi
    
    # Create tab and search
    local tab_id
    tab_id=$(create_jobs_tab) || {
        send_telegram_md "❌ *LinkedIn Jobs Search Failed*\n\nFailed to create browser tab."
        exit 1
    }
    
    # Wait for content
    wait_for_content "$tab_id" || warn "Content wait failed, continuing..."
    
    # Get snapshot
    local snapshot
    if ! snapshot=$(get_snapshot "$tab_id"); then
        warn "Snapshot empty - likely blocked by LinkedIn"
        close_tab "$tab_id"
        send_telegram_md "⚠️ *LinkedIn Jobs Search - Blocked*\n\nLinkedIn appears to be blocking automated access.\nThe page returned empty content (0 chars, 0 refs).\n\n*Query:* \`$SEARCH_QUERY\`\n*Time:* $(date '+%Y-%m-%d %H:%M')\n\n_This is a known limitation - LinkedIn detects headless browsers even with valid cookies. Consider using LinkedIn API or specialized scrapers._"
        exit 0
    fi
    
    # Extract jobs
    local jobs_json
    jobs_json=$(extract_jobs "$tab_id")
    
    # Format and send
    local md
    md=$(format_jobs_md "$jobs_json" "$SEARCH_QUERY")
    
    send_telegram_md "$md"
    log "Results sent to Telegram"
    
    # Cleanup
    close_tab "$tab_id"
    
    log "Done!"
}

# Run main
main "$@"
