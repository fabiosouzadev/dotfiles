## 2. Main Entry Point (`dot_zshrc.tmpl`)

```go
# {{ .chezmoi.sourceFile }} - Modular Zsh Configuration
# Profile: {{ .settings.profile }}
# Generated by chezmoi - DO NOT EDIT DIRECTLY

# ===== EARLY ENVIRONMENT (before anything else) =====
{{- $envFiles := list
  "099-environment.zsh"
-}}
{{- range $envFiles }}
source "{{ .chezmoi.homeDir }}/.zshrc.d/{{ . }}"
{{- end }}

# ===== ZINIT & PLUGINS (must be early) =====
source "{{ .chezmoi.homeDir }}/.zshrc.d/100-zinit.zsh"
source "{{ .chezmoi.homeDir }}/.zshrc.d/110-omz.zsh"
source "{{ .chezmoi.homeDir }}/.zshrc.d/120-plugins.zsh"

# ===== CORE SHELL CONFIG =====
source "{{ .chezmoi.homeDir }}/.zshrc.d/130-history.zsh"
source "{{ .chezmoi.homeDir }}/.zshrc.d/140-completion.zsh"
source "{{ .chezmoi.homeDir }}/.zshrc.d/150-keybindings.zsh"
source "{{ .chezmoi.homeDir }}/.zshrc.d/160-aliases.zsh"
source "{{ .chezmoi.homeDir }}/.zshrc.d/170-functions.zsh"
source "{{ .chezmoi.homeDir }}/.zshrc.d/180-tools.zsh"
source "{{ .chezmoi.homeDir }}/.zshrc.d/190-vi-mode.zsh"

# ===== PROFILE-SPECIFIC (conditional) =====
{{- if .features.workplace.zup }}
source "{{ .chezmoi.homeDir }}/.zshrc.d/200-workplace.zsh"
{{- else if eq .settings.profile "personal" }}
source "{{ .chezmoi.homeDir }}/.zshrc.d/210-personal.zsh"
{{- else if eq .settings.profile "vps" }}
source "{{ .chezmoi.homeDir }}/.zshrc.d/220-vps.zsh"
{{- end }}

# ===== AI INTEGRATIONS =====
{{- if .features.ai.coding_assistants }}
source "{{ .chezmoi.homeDir }}/.zshrc.d/300-ai-tools.zsh"
{{- end }}
{{- if .features.ai.hermes.dashboard.enabled }}
source "{{ .chezmoi.homeDir }}/.zshrc.d/310-hermes.zsh"
{{- end }}
{{- if .features.ai.omniroute.enabled }}
source "{{ .chezmoi.homeDir }}/.zshrc.d/320-omniroute.zsh"
{{- end }}
{{- if .features.ai.coding_orchestrator.enabled }}
source "{{ .chezmoi.homeDir }}/.zshrc.d/330-coding-orchestrator.zsh"
{{- end }}

# ===== ENCRYPTED SECRETS (GPG) =====
{{- if .features.secrets.gpg }}
{{- $secretFiles := list
  "encrypted_api_keys.zsh.asc"
  "encrypted_ssh_config.zsh.asc"
  "encrypted_workplace.zsh.asc"
-}}
{{- range $secretFiles }}
{{- $decrypted := (printf "%s/.config/%s" .chezmoi.homeDir .) | replace ".asc" "" }}
# Decrypt and source {{ . }}
if [[ -f "{{ .chezmoi.homeDir }}/.config/{{ . }}" ]]; then
  source <(gpg --quiet --decrypt "{{ .chezmoi.homeDir }}/.config/{{ . }}" 2>/dev/null)
fi
{{- end }}
{{- end }}

# ===== COMPINIT (MUST BE LAST) =====
source "{{ .chezmoi.homeDir }}/.zshrc.d/999-compinit.zsh"

# ===== STARSHIP PROMPT (after compinit) =====
{{- if .features.prompt.starship }}
eval "$(starship init zsh)"
{{- end }}
```

