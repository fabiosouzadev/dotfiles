services:
  openknowledge:
    build:
      context: .                # diretório onde estão docker‑compose.yml e Dockerfile
      dockerfile: ./Dockerfile
      entrypoint: ./entrypoint.sh
    image: openknowledge:latest
    container_name: openknowledge
    restart: unless-stopped
    expose:
      - "8080"
    environment:
      - OK_ALLOW_EXTERNAL=1
      - TZ=America/Sao_Paulo
    volumes:
      - openknowledge-data:/data
    networks:
      - openknowledge-network
      - edge-network

volumes:
  openknowledge_data: null

networks:
  openknowledge-network:
    name: openknowledge-network
  edge-network:
    external: true