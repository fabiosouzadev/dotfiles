services:
  openknowledge:
    build:
      context: .
      dockerfile: ./Dockerfile
    image: openknowledge:latest
    container_name: openknowledge
    restart: unless-stopped
    expose:
      - "8080"
    environment:
      - OK_ALLOW_EXTERNAL=1
      - OK_EXTERNAL_URL=https://notes-fabiosouzadev.duckdns.org
      - TZ=America/Sao_Paulo
    volumes:
      - openknowledge-data:/data
    networks:
      - openknowledge-network
      - edge-network

volumes:
  openknowledge-data:
    name: openknowledge-data

networks:
  openknowledge-network:
    name: openknowledge-network
  edge-network:
    external: true