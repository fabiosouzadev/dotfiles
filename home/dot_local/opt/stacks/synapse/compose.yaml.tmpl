services:
  synapse:
    image: ghcr.io/element-hq/synapse:sha-5e78aad
    container_name: synapse
    restart: unless-stopped
    environment:
      SYNAPSE_SERVER_NAME: "matrix-fabiosouzadev.duckdns.org"
      SYNAPSE_REPORT_STATS: "no"
      TZ: "America/New_York"
    expose:
      - "8008"
    volumes:
      - ./data:/data
    
    # Healthcheck para monitoramento
    healthcheck:
      test: ["CMD", "curl", "-fSs", "http://localhost:8008/health"]
      interval: 15s
      timeout: 5s
      retries: 3
      start_period: 5s
    
    security_opt:
      - no-new-privileges:true
    
    networks:
      - synapse-network
      - postgres-network
      - edge-network

volumes:
  postgres_data: null
  
networks:
  synapse-network:
    driver: bridge
    name: synapse-network

  postgres-network:
    external: true
  
  edge-network:
    external: true
