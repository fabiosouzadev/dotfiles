services:
  hermes:
    image: nousresearch/hermes-agent:latest
    container_name: hermes
    restart: unless-stopped
    command:
      - gateway
      - run
    expose:
      - 8642
      - 9119
    volumes:
      - /home/ubuntu/.hermes:/opt/data
    environment:
      - PUID=1001
      - PGID=1001
      - OMNIROUTE_BASE_URL=http://omniroute:20129/v1
      - HERMES_DASHBOARD=1
    networks:
      - edge
      - hermes-net
  camofox:
    build:
      context: https://github.com/jo-inc/camofox-browser.git
      args:
        ARCH: arm64
    container_name: camofox
    restart: unless-stopped
    ports:
      - 9377:9377
      - 6080:6080
      - 5901:5900
    environment:
      - CAMOFOX_PORT=9377
      - ENABLE_VNC=1
      - VNC_BIND=0.0.0.0
      - VNC_RESOLUTION=1920x1080
      - MAX_OLD_SPACE_SIZE=2048
    networks:
      - hermes-net
networks:
  hermes-net:
    driver: bridge
  edge:
    external: true
