services:
  hermes:
    image: nousresearch/hermes-agent:latest
    container_name: hermes
    restart: unless-stopped
    command:
      - gateway
      - run
    ports:
      - 8642:8642
      - 9120:9120
    volumes:
      - /home/ubuntu/.hermes:/opt/data
    environment:
      - PUID=1001
      - PGID=1001
      - OMNIROUTE_BASE_URL=http://omniroute:20129/v1
      - HERMES_DASHBOARD=1
      - HERMES_DASHBOARD_PORT=9120
    networks:
      - edge
networks:
  edge:
    external: true
