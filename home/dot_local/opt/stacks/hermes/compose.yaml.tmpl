services:
  hermes:
    image: nousresearch/hermes-agent:latest
    container_name: hermes
    restart: unless-stopped
    command:
      - gateway
      - run
    expose:
      - 8642 # gateway API
      - 9119 # dashboard (only reached when HERMES_DASHBOARD=1)
    volumes:
      - {{ .chezmoi.homeDir }}/.local/share/apps/hermes:/opt/data
    environment:
      - PUID={{ .chezmoi.uid }}
      - PGID={{ .chezmoi.gid }}
      - OMNIROUTE_BASE_URL=http://omniroute:20129/v1
      - CAMOFOX_URL=http://camofox:9377
      - HERMES_DASHBOARD=1
    networks:
      - edge
    shm_size: 1g  
    deploy:
      resources:
        limits:
          memory: 4G
          cpus: "2.0"
networks:
  edge:
    external: true
