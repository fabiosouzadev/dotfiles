services:
  hermes:
    image: nousresearch/hermes-agent:latest
    container_name: hermes
    restart: unless-stopped
    depends_on:
      camofox:
        condition: service_healthy
    command:
      - gateway
      - run
    expose:
      - 8642
      - 9119
    volumes:
      - /home/ubuntu/.hermes:/opt/data
    environment:
      - PUID=1001
      - PGID=1001
      - OMNIROUTE_BASE_URL=http://omniroute:20129/v1
      - CAMOFOX_URL=http://camofox:9377
      - HERMES_DASHBOARD=1
    networks:
      - edge
  camofox:
    build:
      context: https://github.com/jo-inc/camofox-browser.git
      args:
        ARCH: arm64
    container_name: camofox
    restart: unless-stopped
    healthcheck:
      test:
        - CMD
        - curl
        - -f
        - http://localhost:9377/health
      interval: 15s
      timeout: 5s
      retries: 10
    ports:
      - 6080:6080
      - 5901:5900
      - 9377:9377
    environment:
      - CAMOFOX_PORT=9377
      - CAMOFOX_API_KEY=
      - ENABLE_VNC=1
      - VNC_BIND=0.0.0.0
      - VNC_RESOLUTION=1920x1080
      - MAX_OLD_SPACE_SIZE=2048
    volumes:
      - ~/.camofox/cookies:/home/node/.camofox/cookies:ro
    networks:
      - edge
    shm_size: 2gb
    deploy:
      resources:
        limits:
          cpus: "2"
          memory: 3G
networks:
  edge:
    external: true
