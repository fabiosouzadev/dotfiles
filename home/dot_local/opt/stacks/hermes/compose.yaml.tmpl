services:
  hermes:
    image: nousresearch/hermes-agent:latest
    container_name: hermes
    restart: unless-stopped
    command:
      - gateway
      - run
    expose:
      - 8642 # gateway API
      - 9119 # dashboard (only reached when HERMES_DASHBOARD=1)
    volumes:
      - /home/ubuntu/.hermes:/opt/data
      - /home/ubuntu/.camofox/profiles:/opt/data/home/.camofox/profiles:rw # RW!
      - /home/ubuntu/.camofox/cookies:/opt/data/home/.camofox/cookies:ro
      - /home/ubuntu/.camofox/traces:/opt/data/home/.camofox/traces:rw
    environment:
      - PUID=1001
      - PGID=1001
      - OMNIROUTE_BASE_URL=http://omniroute:20129/v1
      - CAMOFOX_URL=http://camofox:9377
      - HERMES_DASHBOARD=1
    networks:
      - edge
    deploy:
      resources:
        limits:
          memory: 4G
          cpus: "2.0"
networks:
  edge:
    external: true
