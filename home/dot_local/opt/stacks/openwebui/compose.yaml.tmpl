services:
  openwebui:
    image: ghcr.io/open-webui/open-webui:latest
    container_name: openwebui
    restart: unless-stopped
    ports:
      - 8080:8080
    environment:
      - OLLAMA_BASE_URL=http://ollama:11434
    volumes:
      - openwebui_data:/app/backend/data
    networks:
      - ollama-network
      - edge-network

volumes:
  openwebui_data: null

networks:
  ollama-network:
    external: true
  edge-network:
    external: true