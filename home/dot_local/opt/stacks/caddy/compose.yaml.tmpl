# ──────────────────────────────────────────────────────────────────────
#  OmniRoute — Docker Compose (Production Snapshot)
# ──────────────────────────────────────────────────────────────────────
#
#  Create a edge network
#
#  Usage:
#    docker network create edge
#
#  networks:
#   edge:
#     external: true
#
#  Docker Networks
#  edge
#  ├── caddy
#  ├── hermes
#  ├── omniroute
#  ├── dockge (opcional)
#  ├── open-webui
#  └── uptime-kuma
#
#  internal
#  ├── postgres
#  ├── redis
#  ├── qdrant
#  └── ollama (se necessário)
#
# ──────────────────────────────────────────────────────────────────────
services:
  caddy:
    container_name: caddy
    image: caddy:alpine
    restart: unless-stopped
    cap_add:
      - NET_ADMIN
    ports:
      - 80:80
      - 443:443
      - 443:443/udp # HTTP/3 support
      - 8642:8642 #hermes gateway
      - 9119:9119 #hermes dashboard
      - 20128:20128 #omniroute dashboard
      - 20129:20129 #omniroute api
      - 20132:20132 #omniroute WebSocket / Streaming
    volumes:
      - {{ .chezmoi.homeDir }}/.local/share/apps/caddy/Caddyfile:/etc/caddy/Caddyfile
      - caddy_data:/data
      - caddy_config:/config
    networks:
      - edge

volumes:
  caddy_data: null
  caddy_config: null
networks:
  edge:
    external: true
