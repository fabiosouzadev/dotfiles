(common) {
    encode zstd gzip

    header {
        -Server
        X-Content-Type-Options nosniff
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    log {
        output stdout
        format json
    }
}

matrix-fabiosouzadev.duckdns.org, http://:8008 {
    import common
    reverse_proxy synapse:8008
}

chat-fabiosouzadev.duckdns.org, http://:8084 {
    import common
    reverse_proxy openwebui:8080
}

http://:8642 {
    import common
    reverse_proxy hermes:8642 {
        transport http {
            read_timeout 300s
            write_timeout 300s
        }
    }
}

http://:9119 {
    import common
    reverse_proxy hermes:9119
}

http://:9999 {
    import common
    reverse_proxy hindsight:9999
}

