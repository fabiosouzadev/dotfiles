services:
  ollama:
    image: ollama/ollama:latest
    container_name: ollama
    restart: unless-stopped
    env_file: .env
    expose:
      - "11434"
    volumes:
      - ollama_data:/root/.ollama
    networks:
      - ollama-network
volumes:
  ollama_data: null
networks:
  ollama-network:
    name: ollama-network