services:
  ollama:
    image: ollama/ollama:latest
    container_name: ollama
    restart: unless-stopped
    command: ["ollama", "serve", "--api-key", "${OLLAMA_API_KEY}"]
    env_file: .env
    expose:
      - "11434"
    volumes:
      - ollama_data:/root/.ollama
    networks:
      - edge
volumes:
  ollama_data: null
networks:
  edge:
    external: true