services:
  redis:
    image: redis:8.6.5-alpine
    container_name: redis
    restart: unless-stopped
    command: >
      redis-server --save 60 1 --appendonly yes --loglevel warning --maxmemory
      512mb --maxmemory-policy allkeys-lru --databases 16
    volumes:
      - redis-data:/data
    expose:
      - "6379"
    healthcheck:
      test:
        - CMD
        - redis-cli
        - ping
      interval: 10s
      timeout: 3s
      retries: 3
    networks:
      - edge
volumes:
  redis-data: null
networks:
  edge:
    external: true
