services:

  # ============================================================
  # PostgreSQL + pgvector
  # ============================================================

  postgres-hindsight:
    image: pgvector/pgvector:pg18
    container_name: postgres-hindsight
    restart: unless-stopped

    env_file:
      - .env

    environment:
      POSTGRES_DB: hindsight
      POSTGRES_USER: hindsight
      POSTGRES_PASSWORD: ${HINDSIGHT_POSTGRES_PASSWORD}

    volumes:
      - hindsight_pg_data:/var/lib/postgresql/18/docker

    healthcheck:
      test:
        - CMD-SHELL
        - pg_isready -U hindsight -d hindsight
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 10s

    security_opt:
      - no-new-privileges:true

    networks:
      # - hindsight-internal-network
      - hindsight-network


  # ============================================================
  # Hindsight API + MCP + UI
  # ============================================================

  hindsight:
    image: ghcr.io/vectorize-io/hindsight:0.9.2
    container_name: hindsight
    restart: unless-stopped

    depends_on:
      postgres-hindsight:
        condition: service_healthy

    env_file:
      - .env

    environment:

      # --------------------------------------------------------
      # Server
      # --------------------------------------------------------

      HINDSIGHT_API_HOST: 0.0.0.0
      HINDSIGHT_API_PORT: 8888

      HINDSIGHT_API_LOG_LEVEL: debug

      # Stable worker identity.
      # Important when running in production.
      HINDSIGHT_API_WORKER_ID: hindsight-vps

      # Enable the built-in API key authentication
      #HINDSIGHT_API_TENANT_API_KEY: ${HINDSIGHT_API_TENANT_API_KEY}


      # --------------------------------------------------------
      # PostgreSQL
      # --------------------------------------------------------

      HINDSIGHT_API_DATABASE_BACKEND: postgresql

      HINDSIGHT_API_DATABASE_URL: >-
        postgresql://hindsight:${HINDSIGHT_POSTGRES_PASSWORD}@postgres-hindsight:5432/hindsight

      HINDSIGHT_API_VECTOR_EXTENSION: pgvector


      # --------------------------------------------------------
      # LLM
      # --------------------------------------------------------

      # Hindsight supports OpenAI-compatible providers.
      # OmniRoute exposes an OpenAI-compatible endpoint.
      HINDSIGHT_API_LLM_PROVIDER: openai

      HINDSIGHT_API_LLM_API_KEY: ${HINDSIGHT_LLM_API_KEY}

      HINDSIGHT_API_LLM_MODEL: nvidia/nemotron-3-ultra-550b-a55b

      HINDSIGHT_API_LLM_BASE_URL: http://omniroute:20129/v1

      # Optional:
      #
      # HINDSIGHT_API_LLM_MAX_CONCURRENT: 4
      # HINDSIGHT_API_LLM_MAX_RETRIES: 3
      # HINDSIGHT_API_LLM_TIMEOUT: 120


      # --------------------------------------------------------
      # MCP
      # --------------------------------------------------------

      HINDSIGHT_API_MCP_ENABLED: "true"

      # Production authentication for MCP.
      HINDSIGHT_API_MCP_AUTH_TOKEN: ${HINDSIGHT_API_MCP_AUTH_TOKEN}

      # Stateless HTTP transport.
      HINDSIGHT_API_MCP_STATELESS: "true"

      # IMPORTANT:
      #
      # Agents only need the core memory operations initially.
      #
      # retain  -> write memory
      # recall  -> retrieve memory
      # reflect -> reason over memory
      #
      # Do NOT expose bank-management/destructive tools to agents
      # until there is a concrete reason to do so.

      HINDSIGHT_API_MCP_ENABLED_TOOLS: >-
        retain,recall,reflect

      HINDSIGHT_API_MCP_INSTRUCTIONS: >-
        You are connected to a centralized persistent memory system
        used by Fabio's AI agents.

        Memory banks have distinct responsibilities.

        PERSONAL:
        durable user preferences, professional context,
        engineering philosophy, communication preferences,
        long-term goals and stable workflow preferences.

        PROJECTS:
        shared engineering knowledge, project architecture,
        architectural decisions, implementation discoveries,
        constraints, lessons learned and project-specific context.

        HERMES:
        Hermes-specific workflows, skills, agent behavior,
        Loop Engineering practices and operational knowledge.

        Use project:<name> tags for project-specific memories.

        Prefer recalling relevant memories before complex tasks.

        Store only durable and reusable knowledge.

        Never store passwords, API keys, access tokens,
        private keys, credentials, cookies or other secrets.

        Do not store transient conversational noise.

        When uncertain whether information belongs in personal,
        projects or hermes memory, prefer the narrowest appropriate
        scope rather than duplicating the information.


      # --------------------------------------------------------
      # Retain
      # --------------------------------------------------------
      #
      # This is intentionally a GENERIC global default.
      #
      # Specific missions for:
      #
      #   personal
      #   projects
      #   hermes
      #
      # should be configured at bank level.
      #
      # This prevents the personal mission from affecting
      # project and Hermes memories.

      HINDSIGHT_API_RETAIN_MISSION: >-
        Prioritize durable, reusable and meaningful information.
        Deprioritize temporary conversational noise,
        transient task details and secrets.
        Prefer explicit user statements over weak inference.
        Never retain passwords, API keys, access tokens,
        private keys, credentials or cookies.


      # Default extraction mode.
      #
      # concise is appropriate for normal long-term memory.
      HINDSIGHT_API_RETAIN_EXTRACTION_MODE: concise


      # --------------------------------------------------------
      # Audit
      # --------------------------------------------------------

      HINDSIGHT_API_AUDIT_LOG_ENABLED: "true"

      # Optional:
      #
      # HINDSIGHT_API_LOG_FORMAT: json


    # ==========================================================
    # Runtime
    # ==========================================================

    shm_size: 1g

    security_opt:
      - no-new-privileges:true


    # ==========================================================
    # Healthcheck
    # ==========================================================

    # healthcheck:
    #   test:
    #     - CMD-SHELL
    #     - curl -fsS http://localhost:8888/health || exit 1
    #   interval: 30s
    #   timeout: 10s
    #   retries: 5
    #   start_period: 30s


    # ==========================================================
    # Ports
    # ==========================================================
    #
    # Keep these exposed only if your reverse proxy / edge
    # architecture requires host-level access.
    #
    # If your reverse proxy is connected directly to
    # edge-network, we can later remove these ports completely.
    #

    ports:
      - "8888:8888"
      - "9999:9999"

    # expose:
    #   - "8888"
    #   - "9999"


    # ==========================================================
    # Networks
    # ==========================================================

    networks:
      # - hindsight-internal-network
      - hindsight-network
      - edge-network


# ==============================================================
# Volumes
# ==============================================================

volumes:
  hindsight_pg_data:
    name: hindsight_pg_data


# ==============================================================
# Networks
# ==============================================================

networks:

  #hindsight-internal-network:
  #  name: hindsight-internal-network

  hindsight-network:
    name: hindsight-network

  edge-network:
    external: true