services:
  postgres:
    image: pgvector/pgvector:pg17
    container_name: postgres
    restart: unless-stopped
    env_file: .env
    environment:
      POSTGRES_DB: hindsight
      POSTGRES_USER: hindsight
      POSTGRES_PASSWORD: ${HINDSIGHT_POSTGRES_PASSWORD}

    volumes:
      - {{ .chezmoi.homeDir }}/.local/share/apps/hindsight/postgres/data:/var/lib/postgresql/data

    healthcheck:
      test:
        - "CMD-SHELL"
        - "pg_isready -U hindsight -d hindsight"
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 20s
    networks:
      - hindsight


  hindsight:
    image: ghcr.io/vectorize-io/hindsight:latest
    container_name: hindsight
    restart: unless-stopped

    depends_on:
      postgres:
        condition: service_healthy

    env_file: .env
    environment:
      # --------------------------------------------------
      # Server
      # --------------------------------------------------
      - HINDSIGHT_API_HOST=0.0.0.0
      - HINDSIGHT_API_PORT=8888
      - HINDSIGHT_API_LOG_LEVEL=info
      - HINDSIGHT_API_LOG_FORMAT=json
      - HINDSIGHT_API_WORKER_ENABLED="true"
      - HINDSIGHT_API_WORKER_ID=hindsight-prod

      # --------------------------------------------------
      # PostgreSQL
      # --------------------------------------------------
      - HINDSIGHT_API_DATABASE_URL=postgresql://hindsight:${HINDSIGHT_POSTGRES_PASSWORD}@postgres:5432/hindsight
      - HINDSIGHT_API_VECTOR_EXTENSION=pgvector

      # --------------------------------------------------
      # LLM
      # --------------------------------------------------

      - HINDSIGHT_API_LLM_PROVIDER=openai
      - HINDSIGHT_API_LLM_API_KEY=${HINDSIGHT_LLM_API_KEY}
      - HINDSIGHT_API_LLM_MODEL=openrouter/nvidia/nemotron-3-embed-1b:free
      - HINDSIGHT_API_LLM_BASE_URL=http://omniroute:20129/v1

      - HINDSIGHT_API_LLM_MAX_CONCURRENT= 4
      - HINDSIGHT_API_LLM_MAX_RETRIES=3
      - HINDSIGHT_API_LLM_TIMEOUT= 120

      # Important for structured memory extraction
      - HINDSIGHT_API_LLM_STRICT_SCHEMA=true

      # --------------------------------------------------
      # Observations / consolidation
      # --------------------------------------------------

      - HINDSIGHT_API_AUDIT_LOG_ENABLED=true

    expose:
      - "8888"

    ports:
      - "9999:9999"

    networks:
      - hindsight
      - edge


networks:
  hindsight:
    name: hindsight
  edge:
    external: true