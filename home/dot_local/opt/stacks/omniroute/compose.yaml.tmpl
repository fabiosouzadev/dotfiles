services:
  omniroute:
    container_name: omniroute
    build:
      context: https://github.com/diegosouzapw/OmniRoute.git#release/v3.8.49
      target: runner-web
    image: omniroute:v3.8.49-web
    restart: unless-stopped
    stop_grace_period: 40s
    env_file: .env
    environment:
      - PUID={{ .chezmoi.uid }}
      - PGID={{ .chezmoi.gid }}
      - NODE_ENV=production
      - DATA_DIR=/app/data
      # - OMNIROUTE_BASE_PATH=${OMNIROUTE_BASE_PATH:-}
      - PORT=20128
      - DASHBOARD_PORT=20128
      - API_PORT=20129
      - API_HOST=0.0.0.0
      - LIVE_WS_PORT=20132
      - LIVE_WS_HOST=0.0.0.0
      - LIVE_WS_ALLOWED_ORIGINS=http://localhost:20128,http://127.0.0.1:20128
      - REDIS_URL=redis://redis:6379/0
      - NODE_OPTIONS=--max-old-space-size=2048
      - BASE_URL=http://omniroute:20128
    ports: ["20128", "20129", "20132"]
    volumes:
      - omniroute-data:/app/data
    healthcheck:
      test:
        - CMD
        - node
        - healthcheck.mjs
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 15s
    networks:
      - edge

volumes:
  omniroute-data:      
networks:
  edge:
    external: true

