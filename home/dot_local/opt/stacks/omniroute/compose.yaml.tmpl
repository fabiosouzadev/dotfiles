services:
  omniroute:
    container_name: omniroute
    build:
      context: https://github.com/diegosouzapw/OmniRoute.git#release/v3.8.49
      target: runner-web
    image: omniroute:v3.8.49-web
    restart: unless-stopped
    stop_grace_period: 40s
    env_file: .env
    environment:
      - PUID={{ .chezmoi.uid }}
      - PGID={{ .chezmoi.gid }}
      - NODE_ENV=production
    expose: ["20128", "20129", "20132"]
    volumes:
      - omniroute-data:/app/data
    healthcheck:
      test:
        - CMD
        - node
        - healthcheck.mjs
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 15s
    networks:
      - edge

volumes:
  omniroute-data:      
networks:
  edge:
    external: true

