services:
  omniroute:
    container_name: omniroute
    build:
      context: https://github.com/diegosouzapw/OmniRoute.git#release/v3.8.49
      target: runner-web
      args:
        OMNIROUTE_USE_TURBOPACK: 1
        OMNIROUTE_BUILD_MEMORY_MB: 4096
    image: omniroute:v3.8.49-web
    restart: unless-stopped
    stop_grace_period: 40s
    env_file: .env
    environment:
      - PUID={{ .chezmoi.uid }}
      - PGID={{ .chezmoi.gid }}
      - APP_LOG_LEVEL=debug
      - NODE_ENV=production
      - DATA_DIR=/app/data
      - DASHBOARD_PORT=20128
      - API_PORT=20129
      - API_HOST=0.0.0.0
      - LIVE_WS_PORT=20132
      - LIVE_WS_HOST=0.0.0.0
      - REDIS_URL=redis://redis:6379/0
      - REQUIRE_API_KEY=true
      - ALLOW_API_KEY_REVEAL=true
      - LIVE_WS_ALLOWED_HOSTS=localhost,omniroute,193.123.97.209
      - QUOTA_STORE_DRIVER=redis # sqlite | redis
      - QUOTA_STORE_REDIS_URL=redis://redis:6379/0 #(apenas quando driver=redis)
      - OMNIROUTE_PUBLIC_BASE_URL=http://193.123.97.209:20128
      - OMNIROUTE_MEMORY_MB=1536
      - NODE_OPTIONS=--max-old-space-size=1536
    expose:
      - "20128"
      - "20129"
      - "20132"
    volumes:
      - omniroute-data:/app/data
    healthcheck:
      test:
        - CMD
        - node
        - healthcheck.mjs
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 15s
    networks:
      - edge
volumes:
  omniroute-data: null
networks:
  edge:
    external: true
