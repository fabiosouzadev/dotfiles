services:
  omniroute:
    build:
      context: .                # diretório onde estão docker‑compose.yml e Dockerfile
      dockerfile: ./Dockerfile
    image: omniroute:v3.8.49-web-qoder
    restart: unless-stopped
    stop_grace_period: 40s
    env_file: .env
    environment:
      # Enviroment
      - PUID={{ .chezmoi.uid }}
      - PGID={{ .chezmoi.gid }}
      - APP_LOG_LEVEL=debug
      - NODE_ENV=production
      # Configs
      - DATA_DIR=/app/data
      - DASHBOARD_PORT=20128
      - API_PORT=20129
      - API_HOST=0.0.0.0
      - LIVE_WS_PORT=20132
      - LIVE_WS_HOST=0.0.0.0
      - LIVE_WS_ALLOWED_HOSTS=localhost,omniroute,193.123.97.209
      - OMNIROUTE_PUBLIC_BASE_URL=http://193.123.97.209:20128
      # Security
      - REQUIRE_API_KEY=true
      - ALLOW_API_KEY_REVEAL=true
      # Redis
      - REDIS_URL=redis://redis:6379/0
      - QUOTA_STORE_DRIVER=redis # sqlite | redis
      - QUOTA_STORE_REDIS_URL=redis://redis:6379/0 #(apenas quando driver=redis)
      #### Price Sync
      #- PRICING_SYNC_ENABLED=true
      #- PRICING_SYNC_SOURCES=litellm
      #- PRICING_SYNC_INTERVAL=21600
      #### Models dev sync
      #- MODELS_DEV_SYNC_ENABLED=true
      #- MODELS_DEV_SYNC_INTERVAL=21600
      #- CONTEXT_WINDOW_RECONCILE_INTERVAL=21600
      #### ARENA SYNC
      #- ARENA_ELO_SYNC_INTERVAL=21600
      - ARENA_ELO_SYNC_ENABLED=false #Erro nesta versão
      #### RAM
      - OMNIROUTE_MEMORY_MB=1024
      - NODE_OPTIONS=--max-old-space-size=1024
      #Rate limit
      - RATE_LIMIT_MAX_WAIT_MS=35000 #15000
      #Healthcheck
      - PROXY_HEALTH_INTERVAL_MS=3600000
      - OMNIROUTE_BUDGET_RESET_JOB_INTERVAL_MS=3600000
    expose:
      - "20128"
      - "20129"
      - "20132"
    volumes:
      - omniroute-data:/app/data
    healthcheck:
      test:
        - CMD
        - node
        - healthcheck.mjs
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 15s
    networks:
      - edge
volumes:
  omniroute-data: null
networks:
  edge:
    external: true
