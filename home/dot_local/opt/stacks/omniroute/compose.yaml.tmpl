services:
  omniroute:
    # build:
    #   context: https://github.com/diegosouzapw/OmniRoute.git#release/v3.8.51
    #   target: runner-web
    #   args:
    #     OMNIROUTE_BASE_PATH: ${OMNIROUTE_BASE_PATH:-}
    #     OMNIROUTE_USE_TURBOPACK: 1
    #     OMNIROUTE_BUILD_MEMORY_MB: 6144
    #     OMNIROUTE_BUILD_WORKERS: 2
    image: diegosouzapw/omniroute:3.8.49-web
    container_name: omniroute
    deploy:
      replicas: 1
    restart: unless-stopped
    stop_grace_period: 40s
    depends_on:
      chatgpt-web-codex-browser:
        condition: service_started
    env_file: .env
    environment:
      # Enviroment
      - APP_LOG_LEVEL=debug
      - NODE_ENV=production
      # Configs
      - DATA_DIR=/app/data
      - DASHBOARD_PORT=20128
      - API_PORT=20129
      - API_HOST=0.0.0.0
      - LIVE_WS_PORT=20132
      - LIVE_WS_HOST=0.0.0.0
      - LIVE_WS_ALLOWED_HOSTS=localhost,omniroute,127.0.0.1,193.123.97.209
      - OMNIROUTE_PUBLIC_BASE_URL=http://193.123.97.209:20128
      - NEXT_PUBLIC_BASE_URL=http://193.123.97.209:20128
      - CHATGPT_WEB_CODEX_CDP_URL=http://chatgpt-web-codex-browser:9223
      # Security
      - REQUIRE_API_KEY=true
      - ALLOW_API_KEY_REVEAL=true
      # Redis
      - REDIS_URL=redis://redis:6379/0
      - QUOTA_STORE_DRIVER=redis # sqlite | redis
      - QUOTA_STORE_REDIS_URL=redis://redis:6379/0 #(apenas quando driver=redis)
      # qdrant
      - QDRANT_ENABLED=true
      - QDRANT_HOST=qdrant
      - QDRANT_PORT=6333
      - QDRANT_GRPC_PORT=6334
      - QDRANT_COLLECTION=omniroute-memory
      - QDRANT_EMBEDDING_MODEL=mistral/mistral-embed
      - QDRANT_VECTOR_SIZE=1024
      - QDRANT_HNSW_EF_CONSTRUCT=100
      - QDRANT_API_KEY=${QDRANT_API_KEY}
      #### Price Sync
      - PRICING_SYNC_ENABLED=true
      - PRICING_SYNC_SOURCES=litellm
      - PRICING_SYNC_INTERVAL=43200
      #### Models dev sync
      - MODELS_DEV_SYNC_ENABLED=true
      - MODELS_DEV_SYNC_INTERVAL=43200
      - CONTEXT_WINDOW_RECONCILE_INTERVAL=43200
      #### ARENA SYNC
      - ARENA_ELO_SYNC_INTERVAL=43200
      - ARENA_ELO_SYNC_ENABLED=false #Erro nesta versão
      #### RAM
      - OMNIROUTE_MEMORY_MB=2048
      - NODE_OPTIONS=--max-old-space-size=2048
      #Rate limit
      - RATE_LIMIT_MAX_WAIT_MS=600000 #15000
      #Healthcheck
      - PROXY_HEALTH_INTERVAL_MS=43200000
      - OMNIROUTE_DISABLE_CREDENTIAL_HEALTH_CHECK=false
      - OMNIROUTE_DISABLE_TOKEN_HEALTHCHECK=false
    expose:
      - "20128"
      - "20129"
      - "20132"
    volumes:
      - ./data:/app/data
    healthcheck:
      test:
        - CMD
        - node
        - healthcheck.mjs
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 15s
    networks:
      - qdrant-network
      - edge-network
      - redis-network
      - chatgpt-web-codex-network


  chatgpt-web-codex-browser:
    build:
      context: https://github.com/diegosouzapw/OmniRoute.git#release/v3.8.51
      dockerfile: docker/chatgpt-web-codex-browser/Dockerfile
    image: omniroute:chatgpt-web-codex-browser
    env_file: .env
    restart: unless-stopped
    shm_size: "2gb"
    environment:
      CDP_PROXY_TOKEN: ${CDP_PROXY_TOKEN}
    volumes:
      - chatgpt-web-codex-browser-data:/browser-profile
    networks:
      - chatgpt-web-codex-network

volumes:
  chatgpt-web-codex-browser-data: null
networks:
  # SECURITY (#13679): dedicated network for the unauthenticated-by-default
  # CDP proxy sidecar (docker/chatgpt-web-codex-browser/cdp-proxy.mjs) —
  # shared only with omniroute-web, not with redis/qdrant/bifrost/cliproxyapi/
  # codex-app-server or any other sibling on the implicit default network.
  chatgpt-web-codex-network:
    name: chatgpt-web-codex-network
  edge-network:
    external: true
  qdrant-network:
    external: true
  redis-network:
    external: true