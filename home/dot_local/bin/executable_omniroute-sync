#!/usr/bin/env bash

# OmniRoute Configuration/State Sync Tool
#
# Modelo de backup:
#
#   OmniRoute runtime
#        │
#        ├── storage.sqlite          NÃO versionado
#        ├── storage.sqlite-wal      NÃO versionado
#        ├── storage.sqlite-shm      NÃO versionado
#        ├── call_logs/              NÃO versionado
#        ├── logs/                   NÃO versionado
#        └── cache/                  NÃO versionado
#
#   Configuração semântica
#        │
#        └── config.sql              → Chezmoi + age
#
#   Secrets/config
#        │
#        └── .env                    → Chezmoi + age
#
# Comandos:
#
#   export          Gera config.sql + manifest
#   push            Exporta e adiciona arquivos ao Chezmoi
#   pull            Restaura config.sql com parada segura do OmniRoute
#   status          Mostra estado do backup/runtime
#   doctor          Procura blobs proibidos/perigosos no Chezmoi
#   fix-permissions Corrige owner/ACL do runtime
#
# Importante:
#
#   Este NÃO é um backup full do OmniRoute.
#
#   É um backup de configuração/estado semântico.
#
#   Histórico de chamadas, logs, cache e runtime não são restaurados.
#
# Modelo de permissões:
#
#   Host:
#     ubuntu:ubuntu = 1001:1001
#
#   Container:
#     node:node = 1000:1000
#
#   O host permanece proprietário do runtime.
#   O container recebe acesso através de ACL.
#
#   Isso evita que o container "roube" o owner do host e
#   também permite que o OmniRoute continue escrevendo normalmente.

set -euo pipefail

###############################################################################
# CONFIGURAÇÃO
###############################################################################

# IMPORTANTE:
#
# Não usamos DATA_DIR aqui.
#
# DATA_DIR é uma variável do runtime do OmniRoute e representa
# /app/data dentro do container.
#
# Este script roda no HOST.
#
# Portanto, o caminho do host é explicitamente controlado por:
#
#   OMNIROUTE_HOME
#   OMNIROUTE_DATA_DIR
#
OMNIROUTE_HOME="${OMNIROUTE_HOME:-${HOME}/.local/opt/stacks/omniroute}"

OMNIROUTE_DATA_DIR="${OMNIROUTE_DATA_DIR:-${OMNIROUTE_HOME}/data}"

DB_FILE="${OMNIROUTE_DATA_DIR}/storage.sqlite"

CONFIG_SQL_FILE="${OMNIROUTE_HOME}/restore/config.sql"

SYNC_DIR="${OMNIROUTE_HOME}/restore/sync"

BACKUP_NOTE_FILE="${SYNC_DIR}/backup-note.txt"

MANIFEST_FILE="${SYNC_DIR}/manifest.json"

# Nome do container Docker.
CONTAINER_NAME="${OMNIROUTE_CONTAINER:-omniroute}"

# Backup temporário criado antes de qualquer restore.
RESTORE_BACKUP_FILE="${DB_FILE}.pre-restore"

# Arquivo temporário usado durante export.
EXPORT_TEMP_DB=""

# Tempo máximo aguardando healthcheck.
HEALTH_TIMEOUT_SECONDS="${OMNIROUTE_HEALTH_TIMEOUT:-120}"

###############################################################################
# IDENTIDADE / PERMISSÕES
###############################################################################

# Usuário proprietário do runtime no HOST.
#
# No seu VPS:
#
#   ubuntu:ubuntu
#   1001:1001
#
HOST_UID="${OMNIROUTE_HOST_UID:-${SUDO_UID:-$(id -u)}}"

HOST_GID="${OMNIROUTE_HOST_GID:-${SUDO_GID:-$(id -g)}}"

# Usuário do OmniRoute dentro do container.
#
# No seu container:
#
#   node:node
#   1000:1000
#
CONTAINER_UID="${OMNIROUTE_CONTAINER_UID:-1000}"

CONTAINER_GID="${OMNIROUTE_CONTAINER_GID:-1000}"

###############################################################################
# ARQUIVOS VERSIONADOS / CRIPTOGRAFADOS
###############################################################################

ENCRYPTED_FILES=(
  .env
  restore/config.sql
  restore/sync/manifest.json
  restore/sync/backup-note.txt
)

###############################################################################
# ARQUIVOS PROIBIDOS NO CHEZMOI
###############################################################################

FORBIDDEN_SOURCE_PATTERNS=(
  'private_dot_omniroute/private_backup.tar.gz'
  'private_dot_omniroute/encrypted_backup.tar.gz.asc'
  'private_dot_omniroute/private_storage.sqlite'
  'private_dot_omniroute/private_storage.sqlite-wal'
  'private_dot_omniroute/private_storage.sqlite-shm'
  'private_dot_omniroute/private_call_logs'
  'private_dot_omniroute/private_db_backups'
  'private_dot_omniroute/private_logs'
  'private_dot_omniroute/private_cache'
)

###############################################################################
# TABELAS DE CONFIGURAÇÃO
###############################################################################

SEMANTIC_TABLES=(
  # Core routing/providers/API access
  provider_connections
  provider_nodes
  combos
  model_combo_mappings
  api_keys
  upstream_proxy_config

  # Dashboard/settings/secrets
  key_value

  # Compression
  compression_combos
  compression_combo_assignments

  # Limits
  api_key_token_limits
  account_key_limits
  provider_key_limits

  # Domains/fallbacks
  domain_budgets
  domain_fallback_chains

  # Groups
  key_groups
  key_group_members
  group_model_permissions

  # Quotas
  quota_groups
  quota_pools
  quota_pool_connections
  quota_allocations

  # Proxy
  proxy_registry
  proxy_assignments

  # Integrations
  relay_tokens
  webhooks
  plugins
  middleware_hooks

  # Agents
  cloud_agent_credentials
  agent_bridge_mappings
  agent_bridge_bypass
  agent_bridge_state
  skills
  api_key_context_sources

  # Tiers
  tier_config
  tier_assignments
)

###############################################################################
# UTILITÁRIOS
###############################################################################

require_cmd() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "❌ Comando obrigatório não encontrado: $1"
    exit 1
  fi
}

source_root() {
  chezmoi source-path 2>/dev/null || true
}

container_exists() {
  docker inspect "$CONTAINER_NAME" >/dev/null 2>&1
}

container_running() {
  docker inspect \
    --format '{{.State.Running}}' \
    "$CONTAINER_NAME" 2>/dev/null |
    grep -q '^true$'
}

container_health_status() {
  docker inspect \
    --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' \
    "$CONTAINER_NAME" 2>/dev/null ||
    echo "missing"
}

container_healthy() {
  [[ "$(container_health_status)" == "healthy" ]]
}

wait_for_health() {
  local elapsed=0
  local status

  echo "⏳ Aguardando OmniRoute ficar saudável..."

  while [ "$elapsed" -lt "$HEALTH_TIMEOUT_SECONDS" ]; do
    status="$(container_health_status)"

    case "$status" in
      healthy)
        echo "✅ OmniRoute está saudável."
        return 0
        ;;

      unhealthy)
        echo "❌ OmniRoute reportou healthcheck: unhealthy"
        return 1
        ;;

      starting|none)
        sleep 5
        elapsed=$((elapsed + 5))
        ;;

      *)
        sleep 5
        elapsed=$((elapsed + 5))
        ;;
    esac
  done

  echo "❌ OmniRoute não ficou saudável em ${HEALTH_TIMEOUT_SECONDS}s."
  echo ""
  echo "Últimos logs:"
  docker logs --tail 100 "$CONTAINER_NAME" 2>&1 || true

  return 1
}

###############################################################################
# SUDO
###############################################################################

run_privileged() {
  if [ "$(id -u)" -eq 0 ]; then
    "$@"
    return
  fi

  require_cmd sudo

  sudo "$@"
}

###############################################################################
# PERMISSÕES
###############################################################################

repair_runtime_permissions() {
  require_cmd setfacl
  require_cmd find
  require_cmd stat

  local runtime_dir="${OMNIROUTE_DATA_DIR}"

  if [ ! -e "$runtime_dir" ]; then
    echo "⚠️ Runtime directory não encontrado:"
    echo "   $runtime_dir"
    return 0
  fi

  if [ ! -d "$runtime_dir" ]; then
    echo "❌ Runtime path não é um diretório:"
    echo "   $runtime_dir"
    return 1
  fi

  echo "🔐 Ajustando permissões do runtime OmniRoute..."
  echo "  Host owner:    ${HOST_UID}:${HOST_GID}"
  echo "  Container UID: ${CONTAINER_UID}"
  echo "  Container GID: ${CONTAINER_GID}"
  echo "  Runtime:       $runtime_dir"

  #
  # O container pode ter executado:
  #
  #   chown -R 1000:1000 /app/data
  #
  # portanto o ubuntu pode ter perdido o owner.
  #
  # Restauramos o owner do host.
  #
  run_privileged \
    chown -R "${HOST_UID}:${HOST_GID}" \
    "$runtime_dir"

  #
  # ACL para o usuário do container.
  #
  # rwX:
  #
  #   arquivos existentes → rw
  #   diretórios           → rwx
  #
  run_privileged \
    setfacl -R \
    -m "u:${CONTAINER_UID}:rwX" \
    "$runtime_dir"

  #
  # ACL explícita no diretório raiz.
  #
  run_privileged \
    setfacl \
    -m "u:${CONTAINER_UID}:rwx" \
    "$runtime_dir"

  #
  # ACL DEFAULT:
  #
  # Novos arquivos/diretórios criados pelo OmniRoute
  # continuarão permitindo acesso ao UID 1000.
  #
  while IFS= read -r -d '' dir; do
    run_privileged \
      setfacl \
      -m "u:${CONTAINER_UID}:rwx" \
      "$dir"

    run_privileged \
      setfacl \
      -m "d:u:${CONTAINER_UID}:rwx" \
      "$dir"
  done < <(
    find "$runtime_dir" \
      -type d \
      -print0
  )

  echo "✓ Permissões ajustadas."

  stat \
    -c '  owner=%U:%G mode=%a path=%n' \
    "$runtime_dir" \
    2>/dev/null || true

  echo ""
  echo "ACL do runtime:"

  getfacl -cp "$runtime_dir" \
    2>/dev/null |
    sed -n '/^user::/,$p' |
    head -n 12 ||
    true
}

###############################################################################
# USAGE
###############################################################################

print_usage() {
  cat <<EOF
Uso:

  omniroute-sync {export|push|pull|status|doctor|fix-permissions}

Comandos:

  export
      Gera restore/config.sql e restore/sync/manifest.json.

  push
      Executa export e adiciona arquivos pequenos ao
      Chezmoi usando criptografia age.

  pull
      Restaura config.sql com segurança.
      O OmniRoute será parado durante o restore.

  status
      Mostra estado do banco, arquivos e container.

  doctor
      Verifica se blobs proibidos foram adicionados
      ao source do Chezmoi.

  fix-permissions
      Corrige owner e ACL do runtime do OmniRoute.

Variáveis opcionais:

  OMNIROUTE_HOME
      Diretório da instalação no host.

      Default:
      \$HOME/.local/opt/stacks/omniroute

  OMNIROUTE_DATA_DIR
      Diretório de runtime no host.

      Default:
      \$OMNIROUTE_HOME/data

  OMNIROUTE_CONTAINER
      Nome do container.

      Default:
      omniroute

  OMNIROUTE_HOST_UID
      UID proprietário do host.

      Default:
      UID do usuário atual.

  OMNIROUTE_HOST_GID
      GID proprietário do host.

      Default:
      GID do usuário atual.

  OMNIROUTE_CONTAINER_UID
      UID do container.

      Default:
      1000

  OMNIROUTE_CONTAINER_GID
      GID do container.

      Default:
      1000

  OMNIROUTE_HEALTH_TIMEOUT
      Timeout do healthcheck em segundos.

      Default:
      120

Exemplo:

  OMNIROUTE_CONTAINER=omniroute omniroute-sync pull

EOF
}

###############################################################################
# VALIDAÇÃO DO AMBIENTE
###############################################################################

check_runtime_directory() {
  if [ ! -d "$OMNIROUTE_HOME" ]; then
    echo "❌ Diretório do OmniRoute não encontrado:"
    echo "   $OMNIROUTE_HOME"
    return 1
  fi

  if [ ! -d "$OMNIROUTE_DATA_DIR" ]; then
    echo "❌ Diretório de dados não encontrado:"
    echo "   $OMNIROUTE_DATA_DIR"
    return 1
  fi

  return 0
}

check_db_files() {
  check_runtime_directory || return 1

  #
  # Primeiro verifica se o diretório é acessível.
  #
  if [ ! -x "$OMNIROUTE_DATA_DIR" ]; then
    echo "❌ Diretório do banco não pode ser atravessado pelo usuário atual:"
    echo "   $OMNIROUTE_DATA_DIR"
    echo ""
    echo "Execute:"
    echo "  omniroute-sync fix-permissions"
    return 1
  fi

  #
  # -e / -f podem falhar como 'missing' quando o problema real
  # é permissão. Como o runtime já deve ter sido reparado,
  # qualquer falha aqui é reportada explicitamente.
  #
  if [ ! -e "$DB_FILE" ]; then
    echo "❌ Banco de dados não encontrado:"
    echo "   $DB_FILE"
    echo ""
    echo "Verifique:"
    echo "  docker exec $CONTAINER_NAME ls -lah /app/data"
    return 1
  fi

  if [ ! -f "$DB_FILE" ]; then
    echo "❌ O caminho do banco existe, mas não é um arquivo:"
    echo "   $DB_FILE"
    return 1
  fi

  if [ ! -r "$DB_FILE" ]; then
    echo "❌ Banco de dados não é legível pelo usuário atual:"
    echo "   $DB_FILE"
    echo ""
    echo "Execute:"
    echo "  omniroute-sync fix-permissions"
    return 1
  fi

  if [ ! -w "$OMNIROUTE_DATA_DIR" ]; then
    echo "❌ Diretório do banco não é gravável:"
    echo "   $OMNIROUTE_DATA_DIR"
    echo ""
    echo "Execute:"
    echo "  omniroute-sync fix-permissions"
    return 1
  fi

  return 0
}

###############################################################################
# SQLITE
###############################################################################

checkpoint_database() {
  require_cmd sqlite3

  echo "🧹 Executando SQLite WAL checkpoint..."

  local result

  result="$(
    sqlite3 "$DB_FILE" \
      'PRAGMA wal_checkpoint(TRUNCATE);' \
      2>&1
  )"

  echo "  $result"
}

integrity_check() {
  require_cmd sqlite3

  echo "🔎 Executando SQLite integrity_check..."

  local result

  result="$(
    sqlite3 "$DB_FILE" \
      'PRAGMA integrity_check;' \
      2>&1
  )"

  if [ "$result" != "ok" ]; then
    echo "❌ SQLite integrity_check falhou:"
    echo "$result"
    return 1
  fi

  echo "✓ SQLite integrity_check: OK"
}

###############################################################################
# EXPORT
###############################################################################

cleanup_export_temp_db() {
  if [ -n "${EXPORT_TEMP_DB:-}" ] &&
     [ -f "$EXPORT_TEMP_DB" ]; then

    rm -f "$EXPORT_TEMP_DB"

    EXPORT_TEMP_DB=""
  fi
}

export_config_sql() {
  require_cmd python3

  mkdir -p "$SYNC_DIR"

  chmod 700 "$SYNC_DIR" 2>/dev/null || true

  cleanup_export_temp_db

  EXPORT_TEMP_DB="$(
    mktemp "$SYNC_DIR/.storage.sqlite.export.XXXXXX"
  )"

  chmod 600 "$EXPORT_TEMP_DB"

  echo "📸 Criando snapshot consistente do SQLite..."

  python3 - "$DB_FILE" "$EXPORT_TEMP_DB" <<'PY'
import sqlite3
import sys

source_path = sys.argv[1]
target_path = sys.argv[2]

source = sqlite3.connect(source_path)
target = sqlite3.connect(target_path)

try:
    source.backup(target)
    target.commit()
finally:
    target.close()
    source.close()
PY

  echo "✓ Snapshot SQLite criado."

  python3 - "$EXPORT_TEMP_DB" "$CONFIG_SQL_FILE" <<'PY'
import sqlite3
import sys
import time

db_path = sys.argv[1]
out_path = sys.argv[2]

tables = [
    'provider_connections',
    'provider_nodes',
    'combos',
    'model_combo_mappings',
    'api_keys',
    'upstream_proxy_config',
    'key_value',
    'compression_combos',
    'compression_combo_assignments',
    'api_key_token_limits',
    'account_key_limits',
    'provider_key_limits',
    'domain_budgets',
    'domain_fallback_chains',
    'key_groups',
    'key_group_members',
    'group_model_permissions',
    'quota_groups',
    'quota_pools',
    'quota_pool_connections',
    'quota_allocations',
    'proxy_registry',
    'proxy_assignments',
    'relay_tokens',
    'webhooks',
    'plugins',
    'middleware_hooks',
    'cloud_agent_credentials',
    'agent_bridge_mappings',
    'agent_bridge_bypass',
    'agent_bridge_state',
    'skills',
    'api_key_context_sources',
    'tier_config',
    'tier_assignments',
]

delete_order = list(reversed(tables))


def q_ident(name):
    return '"' + name.replace('"', '""') + '"'


def q_value(value):
    if value is None:
        return 'NULL'

    if isinstance(value, bool):
        return '1' if value else '0'

    if isinstance(value, int):
        return str(value)

    if isinstance(value, float):
        return repr(value)

    if isinstance(value, bytes):
        return "X'" + value.hex() + "'"

    return "'" + str(value).replace("'", "''") + "'"


con = sqlite3.connect(db_path)

try:
    cur = con.cursor()

    existing = {
        row[0]
        for row in cur.execute(
            "SELECT name "
            "FROM sqlite_master "
            "WHERE type='table'"
        )
    }

    lines = [
        '-- OmniRoute config export',
        f"-- Exported at: {time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())}",
        '-- Generated by omniroute-sync.',
        '-- This is a selective configuration export.',
        '-- Runtime/history/logs/cache are intentionally excluded.',
        'PRAGMA foreign_keys=OFF;',
        'BEGIN TRANSACTION;',
    ]

    #
    # Remove existing semantic configuration during restore.
    #
    for table in delete_order:
        if table in existing:
            lines.append(
                f'DELETE FROM {q_ident(table)};'
            )

    #
    # Export rows.
    #
    for table in tables:
        if table not in existing:
            continue

        rows = cur.execute(
            f'SELECT * FROM {q_ident(table)}'
        ).fetchall()

        columns = [
            description[0]
            for description in cur.description
        ]

        column_sql = ', '.join(
            q_ident(column)
            for column in columns
        )

        for row in rows:
            values_sql = ', '.join(
                q_value(value)
                for value in row
            )

            lines.append(
                f'INSERT OR REPLACE INTO {q_ident(table)} '
                f'({column_sql}) VALUES ({values_sql});'
            )

    lines.append('COMMIT;')

    with open(out_path, 'w', encoding='utf-8') as fh:
        fh.write('\n'.join(lines))
        fh.write('\n')

finally:
    con.close()
PY

  chmod 600 "$CONFIG_SQL_FILE"

  cleanup_export_temp_db

  echo "✓ Configuração SQL exportada:"
  echo "  $CONFIG_SQL_FILE"
}

export_manifest() {
  require_cmd python3

  mkdir -p "$SYNC_DIR"

  python3 - \
    "$OMNIROUTE_HOME" \
    "$SYNC_DIR" \
    "$CONFIG_SQL_FILE" \
    <<'PY'
import hashlib
import json
import os
import sys
import time
from pathlib import Path

root = Path(os.path.expanduser(sys.argv[1]))
sync = Path(os.path.expanduser(sys.argv[2]))
config_sql = Path(os.path.expanduser(sys.argv[3]))


def size(path):
    path = root / path

    if not path.exists():
        return None

    if path.is_file():
        return path.stat().st_size

    total = 0
    files = 0

    for file in path.rglob('*'):
        if file.is_file():
            files += 1
            total += file.stat().st_size

    return {
        'files': files,
        'bytes': total,
    }


def sha256(path):
    if not path.exists():
        return None

    digest = hashlib.sha256()

    with open(path, 'rb') as fh:
        for chunk in iter(
            lambda: fh.read(1024 * 1024),
            b''
        ):
            digest.update(chunk)

    return digest.hexdigest()


manifest = {
    'created_utc': time.strftime(
        '%Y-%m-%dT%H:%M:%SZ',
        time.gmtime()
    ),

    'source_host': os.uname().nodename,

    'omniroute_dir': str(root),

    'backup_model': (
        'encrypted configuration + secrets via chezmoi/age '
        '+ selective semantic SQLite SQL export; '
        'not a full runtime/database backup'
    ),

    'included_files': [
        '.env',
        'config.sql',
        'sync/manifest.json',
        'sync/backup-note.txt',
    ],

    'config_sql': {
        'sha256': sha256(config_sql),
        'size_bytes': (
            config_sql.stat().st_size
            if config_sql.exists()
            else None
        ),
    },

    'semantic_tables': [
        'provider_connections',
        'provider_nodes',
        'combos',
        'model_combo_mappings',
        'api_keys',
        'upstream_proxy_config',
        'key_value',
        'compression_combos',
        'compression_combo_assignments',
        'api_key_token_limits',
        'account_key_limits',
        'provider_key_limits',
        'domain_budgets',
        'domain_fallback_chains',
        'key_groups',
        'key_group_members',
        'group_model_permissions',
        'quota_groups',
        'quota_pools',
        'quota_pool_connections',
        'quota_allocations',
        'proxy_registry',
        'proxy_assignments',
        'relay_tokens',
        'webhooks',
        'plugins',
        'middleware_hooks',
        'cloud_agent_credentials',
        'agent_bridge_mappings',
        'agent_bridge_bypass',
        'agent_bridge_state',
        'skills',
        'api_key_context_sources',
        'tier_config',
        'tier_assignments',
    ],

    'sizes': {
        name: size(name)
        for name in [
            '.env',
            'config.sql',
            'storage.sqlite',
            'call_logs',
            'db_backups',
            'server',
        ]
    },

    'excluded_by_design': [
        'storage.sqlite raw runtime state',
        'storage.sqlite-wal',
        'storage.sqlite-shm',
        'call_logs/',
        'db_backups/',
        'logs/',
        'cache/',
        'server/.pid',
        'monolithic tarball backups',
    ],
}


(sync / 'manifest.json').write_text(
    json.dumps(
        manifest,
        indent=2,
        ensure_ascii=False,
    ) + '\n',
    encoding='utf-8',
)


(sync / 'backup-note.txt').write_text(
    'OmniRoute backup model:\n'
    '- Configuration and secrets are stored encrypted through Chezmoi/age.\n'
    '- Semantic SQLite configuration is exported to config.sql.\n'
    '- Runtime database history, logs, cache and WAL state are intentionally excluded.\n'
    '- Restore must be performed through omniroute-sync pull.\n',
    encoding='utf-8',
)
PY

  chmod 600 \
    "$MANIFEST_FILE" \
    "$BACKUP_NOTE_FILE"

  echo "✓ Manifest gerado:"
  echo "  $MANIFEST_FILE"
}

run_export() {
  echo "📦 Exportando estado seletivo do OmniRoute..."
  echo ""

  #
  # O container pode ter alterado ownership.
  # Corrigimos antes de acessar o banco.
  #
  repair_runtime_permissions

  echo ""

  check_db_files

  export_config_sql

  export_manifest

  echo ""

  echo "✓ Export concluído."
}

###############################################################################
# CHEZMOI
###############################################################################

add_existing_files() {
  require_cmd chezmoi

  echo "🔐 Adicionando arquivos ao Chezmoi com criptografia..."

  for rel in "${ENCRYPTED_FILES[@]}"; do
    local path="$OMNIROUTE_HOME/$rel"

    if [ -f "$path" ]; then
      chezmoi add --encrypt "$path"
      echo "  ✓ $rel"
    else
      echo "  ⚠️ $rel não encontrado; ignorando."
    fi
  done
}

###############################################################################
# DOCTOR
###############################################################################

run_doctor() {
  require_cmd chezmoi

  local src

  src="$(source_root)"

  if [ -z "$src" ] || [ ! -d "$src" ]; then
    echo "⚠️ Não consegui localizar o source do Chezmoi."
    return 1
  fi

  echo "🩺 OmniRoute sync doctor"
  echo ""

  echo "Chezmoi source:"
  echo "  $src"
  echo ""

  local failed=0

  echo "Verificando arquivos proibidos..."

  for pat in "${FORBIDDEN_SOURCE_PATTERNS[@]}"; do
    if [ -e "$src/home/$pat" ]; then
      echo "❌ Proibido encontrado:"
      echo "   home/$pat"
      failed=1
    fi
  done

  local private_dir="$src/home/private_dot_omniroute"

  if [ -d "$private_dir" ]; then
    echo ""
    echo "Verificando arquivos grandes..."

    while IFS= read -r file; do
      [ -z "$file" ] && continue

      local file_size

      file_size="$(
        stat -c%s "$file" 2>/dev/null || echo 0
      )"

      if [ "$file_size" -gt 1048576 ]; then
        case "$file" in
          *.asc)
            echo "ℹ️ Criptografado >1MB:"
            echo "   ${file#$src/} ($file_size bytes)"
            ;;

          *)
            echo "❌ Arquivo plaintext >1MB:"
            echo "   ${file#$src/} ($file_size bytes)"
            failed=1
            ;;
        esac
      fi
    done < <(
      find "$private_dir" \
        -type f \
        2>/dev/null ||
        true
    )
  fi

  echo ""

  if [ "$failed" -eq 0 ]; then
    echo "✅ Doctor: nenhum problema encontrado."
    return 0
  fi

  echo "❌ Doctor encontrou problemas."

  return 1
}

###############################################################################
# RESTORE
###############################################################################

backup_current_database() {
  require_cmd sqlite3

  echo "💾 Criando backup pré-restore..."

  rm -f "$RESTORE_BACKUP_FILE"

  #
  # Neste ponto o container deve estar parado.
  #
  # Primeiro consolidamos WAL/SHM.
  #
  checkpoint_database

  #
  # Agora o banco deve estar em estado consistente para cópia.
  #
  cp -a \
    "$DB_FILE" \
    "$RESTORE_BACKUP_FILE"

  chmod 600 \
    "$RESTORE_BACKUP_FILE" \
    2>/dev/null ||
    true

  echo "✓ Backup pré-restore criado:"
  echo "  $RESTORE_BACKUP_FILE"
}

restore_previous_database() {
  if [ ! -f "$RESTORE_BACKUP_FILE" ]; then
    echo "⚠️ Backup pré-restore não encontrado."
    return 1
  fi

  echo "↩️ Restaurando banco anterior..."

  rm -f "$DB_FILE"

  cp -a \
    "$RESTORE_BACKUP_FILE" \
    "$DB_FILE"

  chmod 600 \
    "$DB_FILE" \
    2>/dev/null ||
    true

  rm -f \
    "${DB_FILE}-wal" \
    "${DB_FILE}-shm"

  echo "✓ Banco anterior restaurado."
}

remove_restore_backup() {
  rm -f "$RESTORE_BACKUP_FILE"
}

restart_container_if_needed() {
  local was_running="$1"

  if [ "$was_running" != true ]; then
    echo ""
    echo "ℹ️ OmniRoute continuará parado porque já estava parado."
    return 0
  fi

  echo ""
  echo "▶️ Iniciando OmniRoute..."

  if ! docker start "$CONTAINER_NAME" >/dev/null; then
    echo "❌ Falha ao iniciar OmniRoute."
    echo ""
    echo "Logs:"
    docker logs --tail 100 "$CONTAINER_NAME" 2>&1 || true
    return 1
  fi

  if ! wait_for_health; then
    echo ""
    echo "❌ OmniRoute iniciou, mas não ficou saudável."
    echo ""
    echo "Logs:"
    docker logs --tail 100 "$CONTAINER_NAME" 2>&1 || true
    return 1
  fi

  #
  # O startup do OmniRoute pode reaplicar:
  #
  #   chown 1000:1000 /app/data
  #
  # Então corrigimos novamente depois do healthcheck.
  #
  repair_runtime_permissions
}

run_pull() {
  require_cmd sqlite3
  require_cmd docker

  echo "📥 OmniRoute selective restore"
  echo "========================================"
  echo ""

  #
  # IMPORTANTE:
  #
  # Primeiro corrigimos o filesystem.
  #
  # Isso resolve o cenário em que:
  #
  #   storage.sqlite existe dentro do container
  #   mas o host não consegue enxergá-lo.
  #
  repair_runtime_permissions

  echo ""

  #
  # Valida arquivos.
  #
  if [ ! -f "$CONFIG_SQL_FILE" ]; then
    echo "❌ Config SQL não encontrado:"
    echo "   $CONFIG_SQL_FILE"
    exit 1
  fi

  if ! check_db_files; then
    exit 1
  fi

  #
  # Valida container.
  #
  if ! container_exists; then
    echo "❌ Container não encontrado:"
    echo "   $CONTAINER_NAME"
    exit 1
  fi

  #
  # Guarda o estado original.
  #
  local was_running=false

  if container_running; then
    was_running=true
  fi

  echo "Estado atual:"
  echo "  Container: $CONTAINER_NAME"
  echo "  Running:   $was_running"
  echo "  Database:  $DB_FILE"
  echo ""

  #
  # Nunca restaurar enquanto OmniRoute estiver usando SQLite.
  #
  if [ "$was_running" = true ]; then
    echo "⏹️ Parando OmniRoute..."

    if ! docker stop \
      --time 45 \
      "$CONTAINER_NAME" \
      >/dev/null; then

      echo "❌ Não foi possível parar o container."
      exit 1
    fi

    echo "✓ OmniRoute parado."
  else
    echo "ℹ️ OmniRoute já estava parado."
  fi

  #
  # O container pode ter feito chown durante o shutdown.
  #
  repair_runtime_permissions

  #
  # Valida novamente depois da parada.
  #
  if ! check_db_files; then
    echo ""
    echo "❌ O banco ficou inacessível após parar o container."
    echo ""
    echo "Estado:"
    ls -ld "$OMNIROUTE_DATA_DIR" 2>&1 || true
    exit 1
  fi

  local restore_success=false

  echo ""
  echo "🔐 Preparando restore..."
  echo ""

  #
  # Backup do estado atual.
  #
  if ! backup_current_database; then
    echo "❌ Não foi possível criar backup pré-restore."

    if [ "$was_running" = true ]; then
      docker start "$CONTAINER_NAME" >/dev/null || true
    fi

    exit 1
  fi

  #
  # Restore.
  #
  echo ""
  echo "🗄️ Importando configuração..."

  if ! sqlite3 "$DB_FILE" < "$CONFIG_SQL_FILE"; then
    echo ""
    echo "❌ Falha durante importação SQL."

    restore_previous_database || true

    repair_runtime_permissions || true

    if [ "$was_running" = true ]; then
      echo "▶️ Reiniciando OmniRoute com banco anterior..."
      docker start "$CONTAINER_NAME" >/dev/null || true
    fi

    exit 1
  fi

  echo "✓ SQL importado."

  #
  # Integridade.
  #
  echo ""

  if ! integrity_check; then
    echo ""
    echo "❌ Banco inválido após restore."

    restore_previous_database || true

    repair_runtime_permissions || true

    if [ "$was_running" = true ]; then
      echo "▶️ Reiniciando OmniRoute com banco anterior..."
      docker start "$CONTAINER_NAME" >/dev/null || true
    fi

    exit 1
  fi

  #
  # O restore foi validado.
  #
  # Como o OmniRoute está parado, podemos remover WAL/SHM
  # eventualmente deixados pelo estado anterior.
  #
  rm -f \
    "${DB_FILE}-wal" \
    "${DB_FILE}-shm"

  echo "✓ Estado WAL/SHM anterior removido."

  #
  # Backup pré-restore não é mais necessário.
  #
  remove_restore_backup

  restore_success=true

  #
  # Reinicia somente se estava rodando antes.
  #
  if ! restart_container_if_needed "$was_running"; then
    echo ""
    echo "⚠️ O restore foi concluído, mas o container não ficou saudável."
    echo ""
    echo "O banco restaurado permanece em:"
    echo "  $DB_FILE"
    exit 1
  fi

  #
  # Resultado final.
  #
  echo ""
  echo "=========================================="
  echo "✅ Restore concluído com sucesso"
  echo "=========================================="
  echo ""

  echo "Configuração restaurada de:"
  echo "  $CONFIG_SQL_FILE"
  echo ""

  if [ "$restore_success" = true ]; then
    echo "Banco validado:"
    echo "  PRAGMA integrity_check = OK"
  fi

  echo ""
}

###############################################################################
# STATUS
###############################################################################

run_status() {
  require_cmd docker

  echo "🔍 OmniRoute Sync Status"
  echo "========================================"
  echo ""

  echo "Host:"
  echo "  OMNIROUTE_HOME:"
  echo "    $OMNIROUTE_HOME"
  echo ""
  echo "  OMNIROUTE_DATA_DIR:"
  echo "    $OMNIROUTE_DATA_DIR"
  echo ""
  echo "  DB:"
  echo "    $DB_FILE"
  echo ""

  echo "Host permissions:"
  if [ -d "$OMNIROUTE_DATA_DIR" ]; then
    ls -ld "$OMNIROUTE_DATA_DIR" 2>/dev/null || true
    echo ""

    getfacl -cp "$OMNIROUTE_DATA_DIR" \
      2>/dev/null |
      sed -n '/^user::/,$p' |
      head -n 12 ||
      true
  else
    echo "  ❌ Runtime directory não encontrado."
  fi

  echo ""

  echo "Container:"
  if ! container_exists; then
    echo "  ❌ $CONTAINER_NAME: Missing"

  elif container_running; then
    echo "  ✅ $CONTAINER_NAME: Running"
    echo "  Health: $(container_health_status)"

  else
    echo "  ⏸️ $CONTAINER_NAME: Stopped"
  fi

  echo ""

  echo "Database:"

  if [ -f "$DB_FILE" ]; then
    echo "  ✅ storage.sqlite"

    stat \
      -c '     owner=%U:%G mode=%a size=%s bytes' \
      "$DB_FILE" \
      2>/dev/null ||
      true
  else
    echo "  ❌ storage.sqlite: Missing"
  fi

  echo ""

  echo "SQLite auxiliary files:"

  for file in \
    "$DB_FILE-wal" \
    "$DB_FILE-shm"
  do
    if [ -f "$file" ]; then
      echo "  ⚠️ $(basename "$file"): present"
    else
      echo "  ✓ $(basename "$file"): absent"
    fi
  done

  echo ""

  echo "Backup files:"

  if [ -f "$RESTORE_BACKUP_FILE" ]; then
    echo "  ⚠️ pre-restore backup:"
    echo "     $RESTORE_BACKUP_FILE"
  else
    echo "  ✓ No pending pre-restore backup"
  fi

  echo ""

  echo "Sync files:"

  for rel in \
    .env \
    restore/config.sql \
    restore/sync/manifest.json \
    restore/sync/backup-note.txt
  do
    local file="$OMNIROUTE_HOME/$rel"

    if [ -f "$file" ]; then
      local size

      size="$(
        du -sh "$file" 2>/dev/null |
        awk '{print $1}'
      )"

      echo "  ✅ $rel ($size)"
    else
      echo "  ⚠️ $rel: Missing"
    fi
  done

  if [ -f "$MANIFEST_FILE" ]; then
  echo ""
  echo "Manifest:"

  python3 - "$MANIFEST_FILE" <<'PY' 2>/dev/null || true
import json
import sys

with open(
    sys.argv[1],
    encoding='utf-8'
) as fh:
    manifest = json.load(fh)

print(
    "  created_utc:",
    manifest.get('created_utc', 'unknown')
)

config = manifest.get(
    'config_sql',
    {}
)

print(
    "  config.sql sha256:",
    config.get(
        'sha256',
        'unknown'
    )
)
PY
  fi
}

###############################################################################
# MAIN
###############################################################################

case "${1:-}" in

  export)
    run_export
    ;;

  push)
    run_export

    echo ""

    add_existing_files

    echo ""

    run_doctor

    echo ""

    echo "=========================================="
    echo "✓ Backup preparado no Chezmoi"
    echo "=========================================="
    echo ""

    echo "Agora revise:"
    echo ""

    echo "  cd ~/.local/share/chezmoi"
    echo "  git status"
    echo ""

    echo "Depois:"
    echo ""

    echo "  git add ."
    echo '  git commit -m "backup: update OmniRoute sync"'
    echo "  git push"
    echo ""
    ;;

  pull)
    run_pull
    ;;

  status)
    run_status
    ;;

  doctor)
    run_doctor
    ;;

  fix-permissions)
    repair_runtime_permissions
    ;;

  *)
    print_usage
    exit 1
    ;;

esac