smtp.server = "smtps://smtp.gmail.com:465"
smtp.sasl.plain.username = "fabio.vanderlei@zup.com.br"
smtp.sasl.plain.password.cmd = "grep '^GMAIL_ZUP_APP_PASSWORD=' /opt/data/.env | cut -d'=' -f2-"

mailbox.alias.inbox = "INBOX"
