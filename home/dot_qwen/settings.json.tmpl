      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/home/fabio.souza/.local/share/mise/shims/node\" \"/home/fabio.souza/.qwen/hooks/gsd-check-update.js\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
