# Default local provider used with `codex --oss`
model = "omniroute/code"
oss_provider = "omniroute"
model_provider = "omniroute"
model_reasoning_effort = "medium"
model_context_window = 400000
model_auto_compact_token_limit = 350000
model_max_output_tokens = 65536
tool_output_token_limit = 32768

[model_providers.omniroute]
name                            = "OmniRoute"
base_url                        = "http://193.123.97.209:20129/v1"
env_key                         = "OMNIROUTE_API_KEY"
requires_openai_auth            = false
wire_api                        = "responses"

[features]
hooks = true

[mcp_servers.hindsight]
command                         = "node"
args                            = ["/home/fabio.souza/.hindsight/coding-agents/dist/mcp-server.js"]
env                             = { HINDSIGHT_MCP_HARNESS = "codex" }